<?xml version="1.0"?>
<!-- *****************************************************************************************************************************************************************************************************-->
<!--EDS with two PartnerIDs (KUNDE1 and KUNDE2) -->
<!--User TLN01 of Partner KUNDE1 sends SEPA credit transfer order (only transport, so the signature is of class T). The OrderID is AA12 assigned by the server -->
<!--User TLN04 of the same PartnerID (=KUNDE1) downloads HVZ and signs the order (for the first time by EDS) --> 
<!-- User TLN4711 of the PartnerID KUNDE2 also downloads HVZ and signs for the second time. --> 
<!-- By this the order is signed completely (two ES neccessary in this case). So the order is authorised and can be processed  -->
<!-- -->
<!-- This HAC is the acknowledgement of the partner KUNDE2 !  -->
<!-- Note: In the HAC of the partner KUNDE2 ONLY activities of users of partner KUNDE 2 are protocolled.  -->
<!-- Regarding the orders of another partner (here: of KUNDE1) this means: ONLY the addition of ESs by users of KUNDE2 and its verification are protocolled. -->
<!-- (for order type HVS it is the same processing) -->
<!-- Date of example file: June 20th 2018 (SIZ GmbH) -->
<!-- -->
<!-- *****************************************************************************************************************************************************************************************************-->
<Document xsi:schemaLocation="urn:iso:std:iso:20022:tech:xsd:pain.002.001.03 pain.002.001.03.xsd" xmlns="urn:iso:std:iso:20022:tech:xsd:pain.002.001.03" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <CstmrPmtStsRpt>
    <GrpHdr>
      <MsgId>2018-05-18T13:20:00.000Z</MsgId>
      <CreDtTm>2018-05-18T13:20:00.000Z</CreDtTm>
      <InitgPty>
        <Id>
          <OrgId>
            <Othr>
              <Id>EBICS-System Kunde2</Id>
            </Othr>
          </OrgId>
        </Id>
      </InitgPty>
    </GrpHdr>
    <OrgnlGrpInfAndSts>
      <OrgnlMsgId>EBICS</OrgnlMsgId>
      <OrgnlMsgNmId>EBICS</OrgnlMsgNmId>
    </OrgnlGrpInfAndSts>
    <!-- user TLN4711 wants to look in his signature folder, so he downloads HVZ: -->
    <OrgnlPmtInfAndSts>
      <OrgnlPmtInfId>FILE_DOWNLOAD</OrgnlPmtInfId>
      <StsRsnInf>
        <Orgtr>
          <Nm>MILLER AND GRANDSONS</Nm>
          <Id>
            <OrgId>
              <Othr>
                <Id>KUNDE2</Id>
                <SchmeNm>
                  <Prtry>PartnerID</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>HVZ</Id>
                <SchmeNm>
                  <Prtry>AdminOrderType</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>TLN4711</Id>
                <SchmeNm>
                  <Prtry>UserID</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>2018-05-18T13:20:01.000Z</Id>
                <SchmeNm>
                  <Prtry>TimeStamp</Prtry>
                </SchmeNm>
              </Othr>
            </OrgId>
          </Id>
        </Orgtr>
        <Rsn>
          <Cd>TS01</Cd>
        </Rsn>
      </StsRsnInf>
    </OrgnlPmtInfAndSts>
    <!-- He signs the Order AA12 (of the company Miller and Sons = PartnerID Kunde1): -->
    <OrgnlPmtInfAndSts>
      <OrgnlPmtInfId>ES_UPLOAD</OrgnlPmtInfId>
      <StsRsnInf>
        <Orgtr>
          <Nm>MILLER AND GRANDSONS</Nm>
          <Id>
            <OrgId>
            <!--Please note: There is no specific order defined for the element groups Othr -->
              <Othr>
                <Id>KUNDE2</Id>
                <SchmeNm>
                  <Prtry>PartnerID</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>HVE</Id>
                <SchmeNm>
                  <Prtry>AdminOrderType</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>BB34</Id>
                <SchmeNm>
                  <Prtry>OrderID</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>TLN4711</Id>
                <SchmeNm>
                  <Prtry>UserID</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>KUNDE1</Id>
                <SchmeNm>
                  <Prtry>PartnerIDRef</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>BTU</Id>
                <SchmeNm>
                  <Prtry>AdminOrderTypeRef</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>SCT</Id>
                <SchmeNm>
                  <Prtry>ServiceNameRef</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>pain.001</Id>
                <SchmeNm>
                  <Prtry>MsgNameRef</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>AA12</Id>
                <SchmeNm>
                  <Prtry>OrderIDRef</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>2018-05-18T13:20:00.999Z</Id>
                <SchmeNm>
                  <Prtry>TimeStamp</Prtry>
                </SchmeNm>
              </Othr>
            </OrgId>
          </Id>
        </Orgtr>
        <Rsn>
          <Cd>TS01</Cd>
        </Rsn>
      </StsRsnInf>
    </OrgnlPmtInfAndSts>
    <!-- ES is verified: -->
    <OrgnlPmtInfAndSts>
      <OrgnlPmtInfId>VEU_VERIFICATION</OrgnlPmtInfId>
      <StsRsnInf>
        <Orgtr>
          <Nm>MILLER AND GRANDSONS</Nm>
          <Id>
            <OrgId>
              <Othr>
                <Id>KUNDE2</Id>
                <SchmeNm>
                  <Prtry>PartnerID</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>HVE</Id>
                <SchmeNm>
                  <Prtry>AdminOrderType</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>BB34</Id>
                <SchmeNm>
                  <Prtry>OrderID</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>TLN4711</Id>
                <SchmeNm>
                  <Prtry>UserID</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>KUNDE1</Id>
                <SchmeNm>
                  <Prtry>PartnerIDRef</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>BTU</Id>
                <SchmeNm>
                  <Prtry>AdminOrderTypeRef</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>SCT</Id>
                <SchmeNm>
                  <Prtry>ServiceNameRef</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>pain.001</Id>
                <SchmeNm>
                  <Prtry>MsgNameRef</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>AA12</Id>
                <SchmeNm>
                  <Prtry>OrderIDRef</Prtry>
                </SchmeNm>
              </Othr>
              <Othr>
                <Id>2018-05-18T13:20:02.999Z</Id>
                <SchmeNm>
                  <Prtry>TimeStamp</Prtry>
                </SchmeNm>
              </Othr>
            </OrgId>
          </Id>
        </Orgtr>
        <Rsn>
          <Cd>DS01</Cd>
        </Rsn>
      </StsRsnInf>
    </OrgnlPmtInfAndSts>
  </CstmrPmtStsRpt>
