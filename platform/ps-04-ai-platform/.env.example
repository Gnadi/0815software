# PS-04 AI Platform — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API server
PORT=4004

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Admin console credentials (single operator in v1)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session token.
SESSION_SECRET=dev-secret-change-me

# Shared secret modules present (X-Service-Token header) to call chat /
# embeddings / RAG.
SERVICE_TOKEN=dev-service-token

SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# ── Model providers ────────────────────────────────────────────────────
# With nothing configured, all inference uses the built-in deterministic
# MOCK provider (zero external calls). Configure any vendor below to enable
# its adapter for chat requests that ask for that provider by name; an
# unconfigured vendor still falls back to the mock.

# Anthropic (provider: "anthropic")
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (provider: "openai")
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (provider: "gemini")
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama — open-source, runs open-weight models locally, no API key.
# Set the base URL to enable it (provider: "ollama").
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Kimi (Moonshot AI) — OpenAI-compatible (provider: "kimi")
# KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-8k
KIMI_BASE_URL=https://api.moonshot.ai/v1

# ── Images · speech · vendor embeddings (optional, OpenAI) ─────────────
# agents/run, images/generate and speech/transcribe run on a deterministic
# offline mock by default. Setting OPENAI_API_KEY (above) activates the real
# OpenAI adapters; the models below are overridable. /api/embeddings uses the
# real vendor only when called with provider:"openai" AND a key is set —
# otherwise the deterministic local mock model is used (RAG always uses mock).
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_SPEECH_MODEL=whisper-1
OPENAI_EMBED_MODEL=text-embedding-3-small

# ── Identity seam ──────────────────────────────────────────────────────
# When set, a Bearer token that is not this service's own admin token is
# verified against PS-01 (POST {IDENTITY_URL}/api/tokens/verify) on caller
# routes, so PS-01-issued end-user sessions are accepted. Unset = standalone.
# IDENTITY_URL=http://localhost:4001
