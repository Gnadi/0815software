# PS-11 Customers — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API
PORT=4011

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Operator console credentials.
# Local-dev defaults are admin / change-me. CHANGE THESE IN PRODUCTION.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the session cookie. Any long random string.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Shared secret modules present (X-Service-Token header) to read and write
# party master data.
SERVICE_TOKEN=dev-service-token

SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# ── Identity seam ──────────────────────────────────────────────────────
# When set, a Bearer token that is not this service's own admin token is
# verified against PS-01 (POST {IDENTITY_URL}/api/tokens/verify), so
# PS-01-issued end-user sessions are accepted. Unset = standalone mode.
# IDENTITY_URL=http://localhost:4001

# ── Hardening (defaults shown; 0 disables a limiter) ───────────────────
# RATE_LIMIT_RPM=600
# LOGIN_RATE_LIMIT_RPM=20
# CORS_ORIGINS=
# REQUEST_TIMEOUT_MS=30000
