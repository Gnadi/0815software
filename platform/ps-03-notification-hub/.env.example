# PS-03 Notification Hub — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API server
PORT=4003

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Admin console credentials (single operator in v1)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session token.
SESSION_SECRET=dev-secret-change-me

# Shared secret required to submit messages (X-Service-Token header on
# POST /api/send).
SERVICE_TOKEN=dev-service-token

SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# ── Providers (optional) ───────────────────────────────────────────────
# Every channel type degrades gracefully to the console provider (marked
# sent, no external call) when its real provider is not configured.
#
# Email — set to send real email via Resend (provider: "resend-email").
# RESEND_API_KEY=
#
# SMS — set both to send via Twilio (provider: "twilio-sms"); a channel may
# override the sender with config.from.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550000000
#
# Slack / Teams / Discord (providers "slack" / "teams" / "discord") take
# their incoming-webhook URL from each channel's own config.url — no global
# env needed. A channel without a url degrades to console.

# ── Identity seam ──────────────────────────────────────────────────────
# When set, a Bearer token that is not this service's own admin token is
# verified against PS-01 (POST {IDENTITY_URL}/api/tokens/verify), so
# PS-01-issued end-user sessions are accepted. Unset = standalone mode.
# IDENTITY_URL=http://localhost:4001

# ── Outbound targets ───────────────────────────────────────────────────
# Slack, Teams and Discord channels post to a URL configured on the channel.
# A target that resolves into private address space (10/8, 127/8,
# 169.254/16, 172.16/12, 192.168/16, ULA and link-local v6) is refused, so a
# channel cannot be pointed at the rest of the stack. List the hostnames
# that ARE meant to be reachable — a generated stack fills its own in.
# EGRESS_ALLOW_HOSTS=invoicing,offers
# block (default) refuses, observe only logs, off disables the check.
# EGRESS_MODE=block
