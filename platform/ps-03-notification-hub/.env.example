# PS-03 Notification Hub — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API server
PORT=4003

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Admin console credentials (single operator in v1)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session token.
SESSION_SECRET=dev-secret-change-me

# Shared secret required to submit messages (X-Service-Token header on
# POST /api/send).
SERVICE_TOKEN=dev-service-token

SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# ── Providers (optional) ───────────────────────────────────────────────
# When RESEND_API_KEY is unset, email channels degrade gracefully to the
# console provider (messages are marked sent without any external call),
# mirroring the marketing site's contact form. Set it to send real email.
# RESEND_API_KEY=

# ── Identity seam (v1: standalone, so this is unused) ──────────────────
# IDENTITY_URL=http://localhost:4001
