# PS-08 Payments — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API server
PORT=4008

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Admin console credentials (single operator in v1)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session token.
SESSION_SECRET=dev-secret-change-me

# Shared secret modules present (X-Service-Token header) to create/confirm/refund.
SERVICE_TOKEN=dev-service-token

# Shared secret used to verify inbound PSP webhook signatures (HMAC-SHA256 hex
# in the X-Signature header).
WEBHOOK_SECRET=dev-webhook-secret

SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# ── PSP provider (optional) ────────────────────────────────────────────
# With no key set, all intents use the deterministic MOCK PSP: confirm moves
# an intent to `processing`, and it settles to `succeeded` on POST /api/tick
# (zero external calls). Set STRIPE_SECRET_KEY to confirm/refund against the
# real Stripe API instead (a single fetch per call; Stripe also emits webhooks
# the inbound receiver reconciles).
# STRIPE_SECRET_KEY=

# ── Identity seam ──────────────────────────────────────────────────────
# When set, a Bearer token that is not this service's own admin token is
# verified against PS-01 (POST {IDENTITY_URL}/api/tokens/verify), so
# PS-01-issued end-user sessions are accepted. Unset = standalone mode.
# IDENTITY_URL=http://localhost:4001
