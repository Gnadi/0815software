# PS-02 Workflow Engine — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API server
PORT=4002

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Admin console credentials (single operator in v1)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session token and outbound webhook
# signatures. Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Shared secret required to ingest events (X-Service-Token header) and on
# the inbound /api/hooks/:token receiver.
SERVICE_TOKEN=dev-service-token

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Set to "true" behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# Optional internal ticker: when > 0, an in-process timer advances the
# scheduler and delivery queue every N milliseconds, so no external cron is
# needed. POST /api/tick still works for tests and cron-driven deployments.
# TICK_INTERVAL_MS=0

# ── Identity seam ──────────────────────────────────────────────────────
# When set, a Bearer token that is not this service's own admin token is
# verified against PS-01 (POST {IDENTITY_URL}/api/tokens/verify), so
# PS-01-issued end-user sessions are accepted. Leave unset for standalone
# mode, where only the local admin token is trusted.
# IDENTITY_URL=http://localhost:4001

# ── Outbound targets ───────────────────────────────────────────────────
# Webhook deliveries go to URLs an operator configures. A target that
# resolves into private address space (10/8, 127/8, 169.254/16, 172.16/12,
# 192.168/16, ULA and link-local v6) is refused, so a configured URL cannot
# be turned into a way to reach the rest of the stack. List the hostnames
# that ARE meant to be reachable — a generated stack fills its own in.
# EGRESS_ALLOW_HOSTS=invoicing,offers
# block (default) refuses, observe only logs, off disables the check.
# EGRESS_MODE=block
