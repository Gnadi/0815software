# PS-09 Search — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API server
PORT=4009

# Path to the SQLite database file (holds the FTS5 index; created automatically)
DATABASE_PATH=./data.db

# Admin console credentials (single operator in v1)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secret used to sign the admin session token.
SESSION_SECRET=dev-secret-change-me

# Shared secret modules present (X-Service-Token header) to index / search.
SERVICE_TOKEN=dev-service-token

SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# ── Identity seam ──────────────────────────────────────────────────────
# When set, a Bearer token that is not this service's own admin token is
# verified against PS-01 (POST {IDENTITY_URL}/api/tokens/verify), so
# PS-01-issued end-user sessions are accepted. Unset = standalone mode.
# IDENTITY_URL=http://localhost:4001
