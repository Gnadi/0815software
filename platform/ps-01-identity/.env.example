# PS-01 Identity — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API server
PORT=4001

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Secret used to sign session tokens and hash-verify API keys.
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Set to "true" behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# ── Identity seam (v1: standalone, so this is unused) ──────────────────
# In a real deployment the other Platform Services verify caller identity
# against PS-01. They would point at this URL; left commented in v1.
# IDENTITY_URL=http://localhost:4001
