# PS-01 Identity — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API server
PORT=4001

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Secret used to sign session tokens and hash-verify API keys.
# Any long random string. Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Set to "true" behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# Public base URL of this service, used to build OAuth redirect URIs.
# SELF_BASE_URL=http://localhost:4001

# ── OAuth / OIDC providers (optional) ──────────────────────────────────
# With nothing configured, /api/oauth/:provider/authorize + callback use a
# deterministic, offline MOCK IdP (zero external calls) — the flow completes
# and provisions/links a user without contacting any provider.
#
# ANY OIDC-compliant provider is configured by name: every
# OAUTH_<NAME>_CLIENT_ID in this file declares a provider called <name>, which
# then serves /api/oauth/<name>/authorize. Give it an issuer and the
# authorize/token/userinfo/JWKS endpoints are read from
# <issuer>/.well-known/openid-configuration at first use and cached:
#
#   OAUTH_KEYCLOAK_ISSUER=https://sso.customer.example/realms/staff
#   OAUTH_KEYCLOAK_CLIENT_ID=ps01
#   OAUTH_KEYCLOAK_CLIENT_SECRET=...
#
# Entra ID needs its tenant-specific issuer, since there is no static one:
#   OAUTH_ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#
# The service prints which providers it recognised on boot — check that line
# after editing, because a misspelled variable declares nothing and fails only
# at somebody's first login.
#
# Per provider, all optional: _SCOPE (default "openid email profile"),
# _AUTHORIZE_URL / _TOKEN_URL / _USERINFO_URL / _JWKS_URI to pin an endpoint
# instead of discovering it, and _PKCE=false for the rare provider that
# rejects PKCE (it is on by default and should stay on). Without an issuer,
# _AUTHORIZE_URL and _TOKEN_URL are required and the service refuses to boot
# without them.
#
# google | microsoft | github keep their built-in endpoint defaults, so an
# existing deployment needs no change.
#
# THE MOCK IdP ISSUES A SESSION WITHOUT ANY CREDENTIAL: anyone who can reach
# the authorize URL becomes a member of the named organization. It is a
# development affordance, so it is OFF whenever NODE_ENV=production and an
# unconfigured provider answers 501 there instead. Override deliberately (a
# staging box that wants the offline flow) with:
# OAUTH_ALLOW_MOCK=false

# Origins the post-login ?redirect_uri= may point at, comma-separated. The
# callback appends the session token to that URL, so anything not listed here
# — and not a same-site path or this service's own SELF_BASE_URL — is refused
# with 422 rather than mailing a token to whoever asked.
# OAUTH_REDIRECT_ALLOWLIST=https://app.customer.example
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ── SCIM 2.0 provisioning ──────────────────────────────────────────────
# Nothing to configure. The endpoint is always mounted at /scim/v2 and
# authenticates with an ordinary PS-01 API key — mint one with
# POST /api/api-keys and paste it into the IdP's provisioning settings:
#
#   Base URL: https://identity.customer.example/scim/v2
#   Token:    psk_...
#
# Scope the key to org:read, user:read, user:write, role:read, role:write so
# that a leaked provisioning token cannot also mint API keys or read the audit
# trail. (org:read is needed because the default `member` role grants it, and
# a key may not hand out authority it does not itself hold.)
# A key scoped that way is additionally unable to touch an account that holds
# permissions it does not (it cannot disable the Owner).

# ── Identity seam (v1: standalone, so this is unused) ──────────────────
# In a real deployment the other Platform Services verify caller identity
# against PS-01. They would point at this URL; left commented in v1.
# IDENTITY_URL=http://localhost:4001

# ── Login backoff (per account) ────────────────────────────────────────
# The per-IP rate limit cannot see a password spray: many addresses, one
# attempt each, all against the same account. So every attempt against one
# (organization, email) pays a delay that grows once the failures pass the
# threshold. Nobody is ever locked out — a lockout would let anyone who knows
# an address keep its owner out — and a correct password clears the record.
# LOGIN_THROTTLE_THRESHOLD=5
# LOGIN_THROTTLE_BASE_MS=1000
# LOGIN_THROTTLE_MAX_MS=30000
# LOGIN_THROTTLE_WINDOW_MS=900000
