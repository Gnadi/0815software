---
// §05 — "What's the catch?"
// FAQ grid with 1px gap dividers

const faqs = [
  {
    q: 'So how do you make money?',
    a: 'With work, not with licenses: setting up, customizing, training and, if you like, running the software for you. The software itself is free; you pay for our services.',
  },
  {
    q: 'Is free software any good?',
    a: 'The same team builds the free software and the paid customizations. Every weakness in the core would cost us time on every project, so it is in our own interest that it works reliably.',
  },
  {
    q: 'What happens if you go out of business?',
    a: 'Nothing changes for you. You have the complete code, and the MIT license allows anyone to keep working on it. Any IT firm or in-house developer can take over.',
  },
  {
    q: 'Isn’t public code a security risk?',
    a: 'No. Good security never depends on nobody seeing the code. Public code can be checked by anyone, so mistakes are found sooner. What is public is the blueprint, never your data: your data lives only on your server, and every installation gets its own keys.',
  },
  {
    q: 'Who looks after updates and the server?',
    a: 'Your choice. Your own IT team can run it, and we hand over everything they need. Or we run it for you, on a server set up for your company alone, including updates and backups.',
  },
  {
    q: 'Why no free trial with a paid version later?',
    a: 'Because a free trial usually means the price tag comes later. With us there is no paid version of the software. There is the software, and there is work we do for you if you want it.',
  },
];
---

<section id="catch" class="catch">
  <div class="catch__inner">
    <div class="section-rail" aria-hidden="true">
      <div class="section-rail__num">§ 05</div>
      <div class="section-rail__name" data-i18n="rail.catch">Questions</div>
    </div>

    <div class="catch__content">
      <div class="section-label-inline" aria-hidden="true">
        <span class="section-label-inline__num">§ 05</span> · <span data-i18n="rail.catch">Questions</span>
      </div>

      <h2 class="catch__h2" data-i18n="catch.h2">“What’s the catch?”</h2>

      <p class="catch__intro" data-i18n="catch.intro">
        A fair question. We would ask it too. Here are the honest answers, the same
        ones we give in every first conversation, before anyone signs anything.
      </p>

      <div class="faq-grid" role="list">
        {faqs.map((f, i) => (
          <article class="faq-cell" role="listitem">
            <div class="faq-cell__num">Q.0{i + 1}</div>
            <h3 class="faq-cell__q" data-i18n={`faq.${i}.q`}>{f.q}</h3>
            <p class="faq-cell__a" data-i18n={`faq.${i}.a`}>{f.a}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.catch {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}

.catch__inner {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
}

.catch__h2 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 56px;
  font-weight: 500;
  line-height: 1;
  letter-spacing: -1.8px;
  margin-bottom: 40px;
}

.catch__intro {
  font-size: 20px;
  line-height: 1.55;
  color: var(--fg-dim);
  max-width: 760px;
  margin-bottom: 56px;
}

/* 2×2 FAQ grid — 1px gap creates hairline dividers */
.faq-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  background: var(--line);
  border: 1px solid var(--line);
}

.faq-cell {
  padding: 32px;
  background: var(--bg);
}

.faq-cell__num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.6px;
  margin-bottom: 14px;
}

.faq-cell__q {
  font-family: 'Inter Tight', sans-serif;
  font-size: 20px;
  font-weight: 500;
  letter-spacing: -0.3px;
  margin-bottom: 12px;
}

.faq-cell__a {
  font-size: 15px;
  line-height: 1.6;
  color: var(--fg-dim);
}

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1199px) {
  .catch__inner { grid-template-columns: 120px 1fr; }
  .catch__h2 { font-size: 44px; letter-spacing: -1.4px; }
}

@media (max-width: 999px) {
  .catch__inner { grid-template-columns: 1fr; }
}

@media (max-width: 767px) {
  .catch__h2 { font-size: 36px; letter-spacing: -1px; }
  .catch__intro { font-size: 17px; margin-bottom: 40px; }
  .faq-grid { grid-template-columns: 1fr; }
  .faq-cell { padding: 24px; }
}
</style>
