---
// §03 — Pillars (Three promises)
// Each promise names its technical term once, links it to the glossary, and
// says what it means for the reader. Grid: 120px | 1fr | 1fr | 1fr

const pillars = [
  {
    title: 'Open source',
    body: 'The blueprint of the software, the <a class="term" href="#g-source">source code</a>, is public. Anyone can check what it does; nothing is hidden. You receive the complete code and may change it, extend it, or hand it to another IT firm.',
    more: 'What does open source mean? →',
    href: '#g-opensource',
  },
  {
    title: 'Free of charge, for good',
    body: 'No <a class="term" href="#g-licensefee">license fee</a>: not for using it, not for more users, not next year. You pay only for work you order from us, such as setup, customization, training or running the software.',
    more: 'What is a license fee? →',
    href: '#g-licensefee',
  },
  {
    title: 'A license on one page',
    body: 'Our software uses the <a class="term" href="#g-mit">MIT license</a>, one of the shortest and most widely used licenses in the world. In plain words:',
    can: [
      'Use it in your company, for any purpose',
      'Change and extend it',
      'Pass it on, or have someone else develop it further',
    ],
    cannot: [
      'Hold us liable: the software comes “as is”',
      'Remove the copyright notice',
    ],
    more: 'The license in plain words →',
    href: '/mit-license',
  },
];
---

<section id="products" class="pillars">
  <!-- Heading row -->
  <div class="pillars__head">
    <div class="section-rail" aria-hidden="true">
      <div class="section-rail__num">§ 03</div>
      <div class="section-rail__name" data-i18n="rail.pillars">Promises</div>
    </div>
    <div>
      <div class="section-label-inline" aria-hidden="true">
        <span class="section-label-inline__num">§ 03</span> · <span data-i18n="rail.pillars">Promises</span>
      </div>
      <h2 class="pillars__h2" data-i18n-html="pillars.h2">
        Three promises.<br />
        No small print.
      </h2>
    </div>
  </div>

  <!-- Cards row -->
  <div class="pillars__grid">
    <div class="pillars__spacer" aria-hidden="true"></div>
    {pillars.map((p, i) => (
      <article class="pillar">
        <div class="pillar__num">§ 03.0{i + 1}</div>
        <h3 class="pillar__title" data-i18n={`pillar.${i}.title`}>{p.title}</h3>
        <p class="pillar__body" data-i18n-html={`pillar.${i}.body`} set:html={p.body} />
        {(p.can || p.cannot) && (
          <ul class="pillar__terms">
            {p.can?.map((t, j) => (
              <li class="pillar__term pillar__term--can">
                <span class="pillar__mark" aria-hidden="true">✓</span>
                <span data-i18n={`pillar.${i}.can.${j}`}>{t}</span>
              </li>
            ))}
            {p.cannot?.map((t, j) => (
              <li class="pillar__term pillar__term--cannot">
                <span class="pillar__mark" aria-hidden="true">✗</span>
                <span data-i18n={`pillar.${i}.cannot.${j}`}>{t}</span>
              </li>
            ))}
          </ul>
        )}
        <a class="pillar__meta" href={p.href} data-i18n={`pillar.${i}.more`}>{p.more}</a>
      </article>
    ))}
  </div>
</section>

<style>
.pillars {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}

/* Heading row: rail + h2 */
.pillars__head {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  margin-bottom: 64px;
  align-items: start;
}

.pillars__h2 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 44px;
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -1.2px;
  max-width: 720px;
}

/* Cards grid */
.pillars__grid {
  display: grid;
  grid-template-columns: 120px repeat(3, 1fr);
  gap: 48px;
}
.pillars__spacer { /* empty rail spacer */ }

/* Pillar card */
.pillar__num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.8px;
  margin-bottom: 20px;
}
.pillar__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 26px;
  font-weight: 500;
  letter-spacing: -0.5px;
  margin-bottom: 16px;
}
.pillar__body {
  font-size: 15px;
  line-height: 1.6;
  color: var(--fg-dim);
  margin-bottom: 28px;
}
.pillar__terms {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin: -12px 0 28px;
  font-size: 14px;
  line-height: 1.5;
}
.pillar__term {
  display: grid;
  grid-template-columns: 18px 1fr;
  gap: 6px;
}
.pillar__term--can    { color: var(--fg); }
.pillar__term--cannot { color: var(--fg-mute); }
.pillar__mark { font-family: 'JetBrains Mono', monospace; }

.pillar__meta {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--fg-dim);
  padding-top: 16px;
  border-top: 1px solid var(--line);
}
.pillar__meta:hover { color: var(--fg); }

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1199px) {
  .pillars__head { grid-template-columns: 120px 1fr; }
  .pillars__grid { grid-template-columns: 120px repeat(3, 1fr); gap: 32px; }
  .pillars__h2 { font-size: 36px; }
}

@media (max-width: 999px) {
  .pillars__head { grid-template-columns: 1fr; }
  .pillars__grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  .pillars__spacer { display: none; }
}

@media (max-width: 767px) {
  .pillars__grid { grid-template-columns: 1fr; gap: 40px; }
  .pillars__h2 { font-size: 28px; letter-spacing: -0.6px; }
}
</style>
