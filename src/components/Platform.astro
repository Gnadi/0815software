---
// §06 — Modules (what we build)
// The homepage shows the modules by the job each one does, in everyday words.
// The shared backend services underneath are summarised in one sentence; the
// full technical catalogue lives on /platform for those who want it.
import { modules } from '../data/modules';

// English one-liners per module, keyed by slug. The German copy lives in
// src/i18n/translations.ts under the same `mod.<slug>.task` keys.
const tasks: Record<string, string> = {
  'customer-portal':      'Customers check their orders, documents and status themselves',
  'admin-dashboard':      'Manage internal lists and tables: filter, edit, export',
  'inventory-management': 'Keep track of stock, storage locations and reorders',
  'invoice-billing':      'Write and send invoices, and pay the bills you receive',
  'employee-directory':   'Who works where: org chart, roles, contact details',
  'procurement-tracker':  'Request, approve and track purchases',
  'storefront':           'Your own online shop, with no cut of your sales',
  'reporting-suite':      'Reports and charts from the data you already have',
  'document-management':  'Store documents, keep versions, control who sees what',
  'crm-lite':             'Customers, contacts and sales opportunities in one place',
  'time-tracking':        'Record working hours per project, for payroll or billing',
  'support-tickets':      'Collect customer requests and work through them',
  'offers':               'Write quotes, send them, and let customers accept online',
  'subsidies-funds':      'Keep track of grants, applications and deadlines',
  'workspace':            'One overview across all your modules',
  'mosaic':               'Several modules side by side on one screen',
};

for (const mod of modules) {
  if (!tasks[mod.slug]) throw new Error(`Platform.astro has no one-line task for module "${mod.slug}"`);
}
---

<section id="platform" class="platform">
  <!-- Heading row -->
  <div class="platform__head">
    <div class="section-rail" aria-hidden="true">
      <div class="section-rail__num">§ 06</div>
      <div class="section-rail__name" data-i18n="rail.modules">Modules</div>
    </div>
    <div class="platform__head-content">
      <div class="section-label-inline" aria-hidden="true">
        <span class="section-label-inline__num">§ 06</span> · <span data-i18n="rail.modules">Modules</span>
      </div>
      <h2 class="platform__h2" data-i18n="platform.h2">What we build: ready-made modules.</h2>
      <p class="platform__intro" data-i18n-html="platform.intro">
        A <a class="term" href="#g-module">module</a> is a finished application for
        one job, such as invoicing, time tracking or a customer portal. Choose what
        you need. Each module runs on its own or together with the others.
      </p>
      <p class="platform__intro platform__intro--sub" data-i18n="platform.intro2">
        All modules stand on the same foundation: login, notifications, file
        storage, search and more. That is why they fit together, and why we can
        deliver quickly.
      </p>
    </div>
  </div>

  <!-- Business Modules -->
  <div class="platform__block">
    <div class="platform__spacer" aria-hidden="true"></div>
    <div class="platform__index platform__index--mod">
      {modules.map((mod) => (
        <a class="mod-row" href={`/modules/${mod.slug}`}>
          <span class="mod-row__num">{mod.n}</span>
          <span class="mod-row__text">
            <span class="mod-row__title" data-i18n={`mod.${mod.slug}.title`}>{mod.title}</span>
            <span class="mod-row__task" data-i18n={`mod.${mod.slug}.task`}>{tasks[mod.slug]}</span>
          </span>
          <span class="mod-row__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>

  <!-- CTA -->
  <div class="platform__cta">
    <div class="platform__spacer" aria-hidden="true"></div>
    <div class="platform__cta-content">
      <a href="/modules" class="btn btn--primary" data-i18n="modules.cta">Explore the modules →</a>
      <a href="/platform" class="btn btn--ghost" data-i18n="platform.cta">How the foundation works →</a>
    </div>
  </div>
</section>

<style>
.platform {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}

.platform__head {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  margin-bottom: 56px;
  align-items: start;
}

.platform__h2 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 44px;
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -1.2px;
  margin-bottom: 24px;
}

.platform__intro {
  font-size: 18px;
  line-height: 1.55;
  color: var(--fg-dim);
  max-width: 680px;
}
.platform__intro--sub {
  margin-top: 16px;
  font-size: 16px;
  color: var(--fg-mute);
}

.platform__block {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
  margin-bottom: 40px;
}

.platform__index { border-top: 1px solid var(--line); }

/* Modules: two-column index, name over the job it does */
.platform__index--mod {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 48px;
}
.mod-row {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
  transition: padding-left 120ms ease-out;
}
.mod-row:hover { padding-left: 8px; }
.mod-row:hover .mod-row__arrow { opacity: 1; }
.mod-row:hover .mod-row__title { color: var(--fg); }
.mod-row__num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.6px;
  flex-shrink: 0;
  width: 58px;
}
.mod-row__text {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}
.mod-row__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 17px;
  font-weight: 500;
  letter-spacing: -0.3px;
  color: var(--fg-dim);
  transition: color 100ms ease-out;
}
.mod-row__task {
  font-size: 14px;
  line-height: 1.45;
  color: var(--fg-mute);
}
.mod-row__arrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 14px;
  color: var(--accent);
  opacity: 0;
  transition: opacity 100ms ease-out;
}

.platform__cta {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
  margin-top: 8px;
}
.platform__cta-content {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1199px) {
  .platform__h2 { font-size: 36px; }
}

@media (max-width: 999px) {
  .platform__head,
  .platform__block,
  .platform__cta { grid-template-columns: 1fr; }
  .platform__spacer { display: none; }
}

@media (max-width: 767px) {
  .platform__h2 { font-size: 28px; letter-spacing: -0.6px; }
  .platform__intro { font-size: 16px; }
  .platform__intro--sub { font-size: 15px; }
  .platform__index--mod { grid-template-columns: 1fr; column-gap: 0; }
}
</style>
