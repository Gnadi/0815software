---
// §05 — Platform (the unified story)
// 0815software is a platform: shared backend services that let us assemble
// standard business software fast and keep it stable and high-quality. The
// modules are what ships on top. One paragraph, then both catalogues.
import { platform } from '../data/platform';
import { modules } from '../data/modules';
---

<section id="platform" class="platform">
  <!-- Heading row -->
  <div class="platform__head">
    <div class="section-rail" aria-hidden="true">
      <div class="section-rail__num">§ 05</div>
      <div class="section-rail__name">Platform</div>
    </div>
    <div class="platform__head-content">
      <div class="section-label-inline" aria-hidden="true">
        <span class="section-label-inline__num">§ 05</span> · Platform
      </div>
      <h2 class="platform__h2" data-i18n="platform.h2">One platform. Standard problems, solved fast.</h2>
      <p class="platform__intro" data-i18n="platform.intro">
        0815software is a platform: eleven shared backend services — identity,
        workflow, notifications, AI, integrations, file storage, audit,
        payments, search, numbering and customer master data — that let us
        assemble standard business software at high speed, with stable,
        high-quality results. The modules are what we ship on top; the platform
        is what makes them quick to build and boring to run.
      </p>
    </div>
  </div>

  <!-- Platform Services -->
  <div class="platform__block">
    <div class="section-rail" aria-hidden="true">
      <div class="section-rail__num">§ 05.01</div>
      <div class="section-rail__name">Services</div>
    </div>
    <div class="platform__index platform__index--svc">
      {platform.map((svc) => (
        <a class="svc-row" href={`/platform/${svc.slug}`}>
          <span class="svc-row__num">{svc.n}</span>
          <span class="svc-row__title" data-i18n={`svc.${svc.slug}.title`}>{svc.title}</span>
          <span class="svc-row__purpose" data-i18n={`svc.${svc.slug}.purpose`}>{svc.purpose}</span>
          <span class="svc-row__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>

  <!-- Workspace — the module that composes the others -->
  <div class="platform__block platform__block--shell">
    <div class="section-rail" aria-hidden="true">
      <div class="section-rail__num">§ 05.02</div>
      <div class="section-rail__name">Workspace</div>
    </div>
    <a class="shell" href="/modules/dashboard">
      <div class="shell__body">
        <div class="shell__eyebrow" aria-hidden="true">MOD-15</div>
        <h3 class="shell__h3" data-i18n="shell.h3">Run several modules? Run them on one screen.</h3>
        <p class="shell__lead" data-i18n="shell.lead">
          Workspace is a board over the modules you licensed. Live widgets from
          each, one customer filter that every one of them honours, the modules
          themselves embedded and already signed in, and actions that reach
          across them — an accepted quote becomes a draft invoice without either
          app being opened. Every module still runs perfectly well on its own.
        </p>
        <span class="shell__cta" data-i18n="shell.cta">See how it composes →</span>
      </div>
      <ul class="shell__points">
        <li data-i18n="shell.point.0">Live figures, computed by the module that owns them</li>
        <li data-i18n="shell.point.1">One customer, filtered across every module at once</li>
        <li data-i18n="shell.point.2">Modules embedded, no second login</li>
        <li data-i18n="shell.point.3">Cross-module actions, recorded against you</li>
      </ul>
    </a>
  </div>

  <!-- Business Modules -->
  <div class="platform__block">
    <div class="section-rail" aria-hidden="true">
      <div class="section-rail__num">§ 05.02</div>
      <div class="section-rail__name">Modules</div>
    </div>
    <div class="platform__index platform__index--mod">
      {modules.map((mod) => (
        <a class="mod-row" href={`/modules/${mod.slug}`}>
          <span class="mod-row__num">{mod.n}</span>
          <span class="mod-row__title" data-i18n={`mod.${mod.slug}.title`}>{mod.title}</span>
          <span class="mod-row__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>

  <!-- CTA -->
  <div class="platform__cta">
    <div class="platform__spacer" aria-hidden="true"></div>
    <div class="platform__cta-content">
      <a href="/platform" class="btn btn--primary" data-i18n="platform.cta">Explore the platform →</a>
      <a href="/modules" class="btn btn--ghost" data-i18n="modules.cta">Explore the modules →</a>
    </div>
  </div>
</section>

<style>
.platform {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}

.platform__head {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  margin-bottom: 56px;
  align-items: start;
}

.platform__h2 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 44px;
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -1.2px;
  margin-bottom: 24px;
}

.platform__intro {
  font-size: 18px;
  line-height: 1.55;
  color: var(--fg-dim);
  max-width: 640px;
}

.platform__block--shell { margin-bottom: 56px; }

.shell {
  display: grid;
  grid-template-columns: 1.35fr 1fr;
  gap: 40px;
  padding: 32px;
  border: 1px solid var(--line);
  background: var(--bg-2, rgba(255, 255, 255, 0.02));
  text-decoration: none;
  color: inherit;
  transition: border-color 0.14s ease;
}

.shell:hover { border-color: var(--fg-dim); }

.shell__eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.14em;
  color: var(--fg-mute, var(--fg-dim));
  margin-bottom: 14px;
}

.shell__h3 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 26px;
  font-weight: 500;
  line-height: 1.15;
  letter-spacing: -0.6px;
  margin-bottom: 16px;
}

.shell__lead {
  font-size: 16px;
  line-height: 1.6;
  color: var(--fg-dim);
  margin-bottom: 20px;
}

.shell__cta {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  letter-spacing: 0.08em;
}

.shell__points {
  list-style: none;
  margin: 0;
  padding: 0;
  align-self: center;
  display: grid;
  gap: 10px;
}

.shell__points li {
  font-size: 14px;
  line-height: 1.45;
  color: var(--fg-dim);
  padding-left: 18px;
  position: relative;
}

.shell__points li::before {
  content: '\u2192';
  position: absolute;
  left: 0;
  color: var(--fg-mute, var(--fg-dim));
}

@media (max-width: 900px) {
  .shell { grid-template-columns: 1fr; gap: 24px; padding: 24px; }
  .shell__h3 { font-size: 22px; }
}

.platform__block {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
  margin-bottom: 40px;
}

.platform__index { border-top: 1px solid var(--line); }

/* Services: single column with a purpose blurb */
.svc-row {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
  transition: padding-left 120ms ease-out;
}
.svc-row:hover { padding-left: 8px; }
.svc-row:hover .svc-row__arrow { opacity: 1; }
.svc-row:hover .svc-row__title { color: var(--fg); }

.svc-row__num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.6px;
  flex-shrink: 0;
  width: 58px;
}
.svc-row__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 17px;
  font-weight: 500;
  letter-spacing: -0.3px;
  color: var(--fg-dim);
  flex-shrink: 0;
  width: 190px;
  transition: color 100ms ease-out;
}
.svc-row__purpose {
  font-size: 14px;
  line-height: 1.5;
  color: var(--fg-mute);
  flex: 1;
}
.svc-row__arrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 14px;
  color: var(--accent);
  opacity: 0;
  transition: opacity 100ms ease-out;
}

/* Modules: two-column compact index */
.platform__index--mod {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 48px;
}
.mod-row {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
  transition: padding-left 120ms ease-out;
}
.mod-row:hover { padding-left: 8px; }
.mod-row:hover .mod-row__arrow { opacity: 1; }
.mod-row:hover .mod-row__title { color: var(--fg); }
.mod-row__num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.6px;
  flex-shrink: 0;
  width: 58px;
}
.mod-row__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 17px;
  font-weight: 500;
  letter-spacing: -0.3px;
  color: var(--fg-dim);
  flex: 1;
  transition: color 100ms ease-out;
}
.mod-row__arrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 14px;
  color: var(--accent);
  opacity: 0;
  transition: opacity 100ms ease-out;
}

.platform__cta {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
  margin-top: 8px;
}
.platform__cta-content {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1199px) {
  .platform__h2 { font-size: 36px; }
  .svc-row__title { width: 170px; }
}

@media (max-width: 999px) {
  .platform__head,
  .platform__block,
  .platform__cta { grid-template-columns: 1fr; }
  .platform__spacer { display: none; }
}

@media (max-width: 767px) {
  .platform__h2 { font-size: 28px; letter-spacing: -0.6px; }
  .platform__intro { font-size: 16px; }
  .svc-row { flex-wrap: wrap; row-gap: 4px; }
  .svc-row__title { width: auto; flex: 1; }
  .svc-row__purpose { flex-basis: 100%; order: 3; }
  .platform__index--mod { grid-template-columns: 1fr; column-gap: 0; }
}
</style>
