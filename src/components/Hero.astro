---
// §01 — Hero / Overview
// Grid: 120px | 1fr | 320px

const specRows: [string, string, boolean?][] = [
  ['LICENSE FEE',  '€0.00', true],
  ['MODULES',      'Your choice'],
  ['OWNER',        'You'],
  ['YOUR DATA',    'Your server'],
  ['OPERATION',    'You or us'],
  ['DEPENDENCY',   'None'],
  ['READY IN',     '2–6 weeks'],
];
---

<section id="hero" class="hero">
  <div class="hero__grid">

    <!-- Left rail -->
    <div class="section-rail" aria-hidden="true">
      <div class="section-rail__num">§ 01</div>
      <div class="section-rail__name" data-i18n="rail.hero">Overview</div>
    </div>

    <!-- Center -->
    <div class="hero__center">
      <!-- Inline label for tablet/mobile -->
      <div class="section-label-inline" aria-hidden="true">
        <span class="section-label-inline__num">§ 01</span> · <span data-i18n="rail.hero">Overview</span>
      </div>

      <p class="hero__eyebrow">
        <span class="hero__dot" aria-hidden="true">●</span>
        <span data-i18n="hero.eyebrow">Your own SaaS, built from modules</span>
      </p>

      <h1 class="hero__h1" data-i18n-html="hero.h1">
        Standard software,<br />
        built to a <em class="hero__serif">higher</em> standard.
      </h1>

      <!-- Plain words first; the two terms a newcomer will not know link to
           the glossary further down the page rather than being assumed. -->
      <p class="hero__subhead" data-i18n-html="hero.subhead">
        Everyday software for your business: invoicing, time tracking, customer
        management, an online shop. You put together your own package from
        ready-made modules, and we run it for you if you like. You use it in the
        browser just like rented software (<a class="term" href="#g-saas">SaaS</a>),
        but without license fees, and it belongs to you,
        <a class="term" href="#g-source">source code</a> included.
      </p>

      <div class="hero__ctas">
        <a href="#contact" class="btn btn--primary" data-i18n="hero.cta1">Request a project →</a>
        <a href="/demo" class="btn btn--ghost" data-i18n="hero.cta3">Try the live demo →</a>
        <a href="#use-cases" class="btn btn--ghost" data-i18n="hero.cta2">See the use cases →</a>
      </div>
    </div>

    <!-- Right: at-a-glance card -->
    <aside class="spec-card" aria-label="At a glance">
      <div class="spec-card__header">
        <span data-i18n="spec.h">AT A GLANCE</span>
        <span>0815/A</span>
      </div>
      <dl class="spec-card__list">
        {specRows.map(([k, v, isAccent], i) => (
          <div class="spec-card__row">
            <dt class="spec-card__key" data-i18n={`spec.k.${i}`}>{k}</dt>
            <dd class={`spec-card__val${isAccent ? ' spec-card__val--accent' : ''}`} data-i18n={`spec.v.${i}`}>{v}</dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>

<style>
.hero {
  padding: var(--sec-y) var(--pad-x) var(--sec-y-sm);
  border-bottom: 1px solid var(--line);
}

.hero__grid {
  display: grid;
  grid-template-columns: 120px 1fr 320px;
  gap: 48px;
  align-items: start;
}

/* Eyebrow */
.hero__eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--fg-dim);
  margin-bottom: 32px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.hero__dot { color: var(--accent); }

/* H1 */
.hero__h1 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 104px;
  font-weight: 500;
  line-height: 0.92;
  letter-spacing: -3.5px;
  max-width: 900px;
  color: var(--fg);
}
.hero__serif {
  font-family: 'Instrument Serif', Georgia, serif;
  font-style: italic;
  font-weight: 400;
}

/* Subhead */
.hero__subhead {
  margin-top: 40px;
  font-size: 19px;
  line-height: 1.55;
  color: var(--fg-dim);
  max-width: 620px;
}

/* CTAs */
.hero__ctas {
  display: flex;
  gap: 12px;
  margin-top: 48px;
  flex-wrap: wrap;
}

/* ─── Spec card ──────────────────────────────────────────────────── */
.spec-card {
  border: 1px solid var(--line-strong);
  padding: 24px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  line-height: 1.9;
  background: rgba(255, 255, 255, 0.01);
}

.spec-card__header {
  display: flex;
  justify-content: space-between;
  font-size: 10px;
  color: var(--fg-mute);
  letter-spacing: 1px;
  padding-bottom: 12px;
  margin-bottom: 4px;
  border-bottom: 1px solid var(--line);
}

.spec-card__list {
  display: flex;
  flex-direction: column;
}

.spec-card__row {
  display: flex;
  justify-content: space-between;
  gap: 16px;
}

.spec-card__key  { color: var(--fg-mute); }
.spec-card__val  { color: var(--fg); }
.spec-card__val--accent { color: var(--accent); }

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1199px) {
  .hero__grid {
    grid-template-columns: 120px 1fr 280px;
    gap: 40px;
  }
  .hero__h1 { font-size: 80px; letter-spacing: -2.5px; }
}

@media (max-width: 999px) {
  .hero__grid {
    grid-template-columns: 1fr;
  }
  .hero__h1 { font-size: 64px; letter-spacing: -2px; }
  .spec-card { margin-top: 8px; }
}

@media (max-width: 767px) {
  .hero__h1 {
    font-size: 48px;
    letter-spacing: -1.5px;
    line-height: 0.96;
  }
  .hero__subhead { font-size: 17px; }
  .hero__ctas { flex-direction: column; align-items: flex-start; }
}
</style>
