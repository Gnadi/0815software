---
// §05 — Modules (catalogue teaser)
// Compact index of all fourteen modules + a CTA to explore the catalogue.
import { modules } from '../data/modules';
---

<section id="modules" class="modules">
  <!-- Heading row -->
  <div class="modules__head">
    <div class="section-rail" aria-hidden="true">
      <div class="section-rail__num">§ 05</div>
      <div class="section-rail__name">Modules</div>
    </div>
    <div class="modules__head-content">
      <div class="section-label-inline" aria-hidden="true">
        <span class="section-label-inline__num">§ 05</span> · Modules
      </div>
      <h2 class="modules__h2" data-i18n="modules.h2">Fourteen modules, ready to go.</h2>
      <p class="modules__intro" data-i18n="modules.intro">
        Each one is a solved standard business problem — MIT-licensed, fully
        sourced, and handed off in weeks. Open any module to see the interface
        and what it does.
      </p>
    </div>
  </div>

  <!-- Compact index -->
  <div class="modules__grid">
    <div class="modules__spacer" aria-hidden="true"></div>
    <div class="modules__index">
      {modules.map((mod) => (
        <a class="mod-row" href={`/modules/${mod.slug}`}>
          <span class="mod-row__num">{mod.n}</span>
          <span class="mod-row__title">{mod.title}</span>
          <span class="mod-row__arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>

  <!-- CTA -->
  <div class="modules__cta">
    <div class="modules__spacer" aria-hidden="true"></div>
    <div class="modules__cta-content">
      <a href="/modules" class="btn btn--primary" data-i18n="modules.cta">Explore the modules →</a>
      <a href="/#contact" class="btn btn--ghost" data-i18n="modules.cta2">Commission a custom scope</a>
    </div>
  </div>
</section>

<style>
.modules {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}

.modules__head {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  margin-bottom: 56px;
  align-items: start;
}

.modules__h2 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 44px;
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -1.2px;
  margin-bottom: 24px;
}

.modules__intro {
  font-size: 18px;
  line-height: 1.55;
  color: var(--fg-dim);
  max-width: 620px;
}

.modules__grid {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
}
.modules__spacer { /* rail spacer */ }

/* Two-column index of module rows, 1px hairline dividers */
.modules__index {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 48px;
  border-top: 1px solid var(--line);
}

.mod-row {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding: 18px 0;
  border-bottom: 1px solid var(--line);
  transition: padding-left 120ms ease-out;
}
.mod-row:hover { padding-left: 8px; }
.mod-row:hover .mod-row__arrow { opacity: 1; }
.mod-row:hover .mod-row__title { color: var(--fg); }

.mod-row__num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.6px;
  flex-shrink: 0;
  width: 58px;
}

.mod-row__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 17px;
  font-weight: 500;
  letter-spacing: -0.3px;
  color: var(--fg-dim);
  flex: 1;
  transition: color 100ms ease-out;
}

.mod-row__arrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 14px;
  color: var(--accent);
  opacity: 0;
  transition: opacity 100ms ease-out;
}

.modules__cta {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
  margin-top: 48px;
}
.modules__cta-content {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1199px) {
  .modules__h2 { font-size: 36px; }
}

@media (max-width: 999px) {
  .modules__head,
  .modules__grid,
  .modules__cta { grid-template-columns: 1fr; }
  .modules__spacer { display: none; }
}

@media (max-width: 767px) {
  .modules__h2 { font-size: 28px; letter-spacing: -0.6px; }
  .modules__intro { font-size: 16px; }
  .modules__index { grid-template-columns: 1fr; column-gap: 0; }
}
</style>
