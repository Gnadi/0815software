---
import SubPage from '../layouts/SubPage.astro';

export const prerender = true;

const releases = [
  {
    version: 'v0.8.0',
    date: '2026-10-30',
    title: 'Reports that ask',
    changes: [
      { type: 'Added', text: 'Reporting Suite: Excel downloads and scheduled Excel exports, the pivot as a second sheet — written without a library and checked against the published ECMA-376 schemas' },
      { type: 'Added', text: 'Reporting Suite: report parameters — from, to, region — bound by the database, never pasted into the SQL; relative dates such as “start of last month” resolved in the office’s time zone' },
      { type: 'Added', text: 'Reporting Suite: schedules and charts keep their parameter values; an embedded chart always shows the values it was saved with' },
      { type: 'Added', text: 'Reporting Suite: pie, area, grouped and stacked bar charts and several lines, with a legend and values on hover' },
      { type: 'Fixed', text: 'Reporting Suite: the sidebar no longer spreads its entries over the whole height, and table rows with buttons line up again' },
    ],
  },
  {
    version: 'v0.7.0',
    date: '2026-10-29',
    title: 'The help desk',
    changes: [
      { type: 'Added', text: 'Support Tickets: SLA in business hours with holidays, paused while a ticket waits on the requester — a versioned policy set in the UI, so a change never rewrites old verdicts' },
      { type: 'Added', text: 'Support Tickets: attachments on the request, replies and follow-ups, never served to the requester from an internal note' },
      { type: 'Added', text: 'Support Tickets: canned responses with placeholders, replies by email, and satisfaction ratings once per resolution' },
      { type: 'Added', text: 'Integration Hub: IMAP mailboxes — unread mail parsed and handed over, marked read only once the module has it; Support Tickets reads its mailbox through it' },
      { type: 'Fixed', text: 'Support Tickets: the sidebar no longer spreads its entries over the whole height' },
    ],
  },
  {
    version: 'v0.6.0',
    date: '2026-10-29',
    title: 'Self-service',
    changes: [
      { type: 'Added', text: 'Time Tracking: a start/stop timer that runs on the server and stops into an ordinary entry, capped at midnight and the daily maximum' },
      { type: 'Added', text: 'Time Tracking: My area — the own week, flexitime, leave and tasks on one screen' },
      { type: 'Added', text: 'Time Tracking: reminders for an unsubmitted week and a forgotten timer, through the notification hub' },
      { type: 'Added', text: 'Employee Directory: people keep their own contact details current; name and address changes are approved by HR' },
      { type: 'Fixed', text: 'A Time Tracking test that failed once the calendar reached its fixed week' },
    ],
  },
  {
    version: 'v0.5.0',
    date: '2026-10-24',
    title: 'The incoming side',
    changes: [
      { type: 'Added', text: 'Three-way match: a bill for a purchase order is paid only once the goods have arrived (Procurement ↔ Inventory ↔ Invoice & Billing)' },
      { type: 'Added', text: 'Procurement Tracker: goods receipts against ordered POs, booked into Inventory Management' },
      { type: 'Added', text: 'AI Platform: invoice extraction — e-invoices read exactly, printed PDFs from their labels, scans by a vision model' },
      { type: 'Added', text: 'Invoice & Billing: read a supplier invoice into a bill, with its lines, instead of typing it; the same document twice is flagged' },
      { type: 'Added', text: 'Three-way match line by line: the supplier’s article number against the PO line, quantity against what arrived, price against the order' },
    ],
  },
  {
    version: 'v0.4.0',
    date: '2026-10-22',
    title: 'Many users, and the order chain',
    changes: [
      { type: 'Added',   text: 'Per-person access levels (view, edit, manage) in every module, through PS-01 sign-in' },
      { type: 'Added',   text: 'Orders & Delivery Notes module — order confirmations, partial deliveries, one invoice per delivery' },
      { type: 'Added',   text: 'Invoice & Billing: dunning in levels, recurring invoices, partial credit notes, billing a delivery note' },
      { type: 'Added',   text: 'Inventory Management: barcodes and labels, reservations for confirmed orders' },
      { type: 'Added',   text: 'Time Tracking: absences with approval, flexitime and overtime, a task board per project' },
      { type: 'Changed', text: 'The module generator first checks whether a topic belongs in an existing module' },
    ],
  },
  {
    version: 'v0.3.0',
    date: '2026-04-01',
    title: 'Spring clean',
    changes: [
      { type: 'Added',    text: 'Document Management module (beta) — upload, tag, version, access control' },
      { type: 'Added',    text: 'Reporting Suite exports to CSV and XLSX' },
      { type: 'Fixed',    text: 'Invoice PDF rendering on Safari 17' },
      { type: 'Fixed',    text: 'Date formatting in German locale across all modules' },
      { type: 'Breaking', text: 'Admin Dashboard API endpoints now require JWT; cookie-based auth removed' },
    ],
  },
  {
    version: 'v0.2.1',
    date: '2026-02-14',
    title: 'Patch release',
    changes: [
      { type: 'Fixed', text: 'Customer Portal session timeout edge case on slow connections' },
      { type: 'Fixed', text: 'Procurement Tracker approval emails not sending in EU region' },
      { type: 'Fixed', text: 'Inventory Management SKU search returning partial matches incorrectly' },
    ],
  },
  {
    version: 'v0.2.0',
    date: '2026-01-20',
    title: 'CRM and billing',
    changes: [
      { type: 'Added',   text: 'CRM Lite module — contacts, deals, activity log, pipeline view' },
      { type: 'Added',   text: 'Invoice & Billing module — PDF generation, payment status, customer ledger' },
      { type: 'Changed', text: 'Project hand-off process now includes Terraform scripts for common cloud targets' },
      { type: 'Changed', text: 'Admin Dashboard table columns now configurable without code changes' },
    ],
  },
  {
    version: 'v0.1.0',
    date: '2025-12-01',
    title: 'First public release',
    changes: [
      { type: 'Added', text: 'Customer Portal v1 — order status, documents, history' },
      { type: 'Added', text: 'Admin Dashboard v1 — generic CRUD over any data model' },
      { type: 'Added', text: 'Inventory Management v1 — stock, SKUs, warehouse locations' },
      { type: 'Added', text: 'MIT license confirmed; all repositories public on GitHub' },
      { type: 'Added', text: 'Zero external SaaS dependencies across all modules' },
    ],
  },
];

const typeColor: Record<string, string> = {
  Added:    'var(--accent)',
  Fixed:    'var(--fg-dim)',
  Changed:  'var(--fg-dim)',
  Breaking: '#e87070',
};
---

<SubPage
  title="Changelog — 0815software"
  description="The 0815software release log. Every release, every breaking change, every fix — in order, no spin."
  section="§ P3"
  sectionName="Changelog"
  eyebrow="DIN 0815/C · RELEASE LOG"
  heading="Changelog."
  lead="Every release, every breaking change, every fix. In order. No spin."
>

  <!-- Release entries -->
  <section class="changelog-section">
    <div class="changelog__inner">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">§ P3.01</div>
        <div class="section-rail__name">Releases</div>
      </div>
      <div class="changelog__entries">
        {releases.map((rel) => (
          <article class="changelog-entry">
            <div class="changelog-entry__rail">
              <div class="changelog-entry__version">{rel.version}</div>
              <div class="changelog-entry__date">{rel.date}</div>
            </div>
            <div class="changelog-entry__content">
              <h2 class="changelog-entry__title">{rel.title}</h2>
              <ul class="change-list">
                {rel.changes.map((c) => (
                  <li class="change-list__item">
                    <span class="change-list__type" style={`color: ${typeColor[c.type] ?? 'var(--fg-mute)'}`}>{c.type}</span>
                    <span class="change-list__text">{c.text}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Versioning policy -->
  <section class="changelog-policy-section">
    <div class="changelog-policy__inner">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">§ P3.02</div>
        <div class="section-rail__name">Policy</div>
      </div>
      <p class="changelog-policy__body">
        Semantic versioning. Breaking changes only in minor bumps until v1.0. After v1.0, breaking changes require a major bump and 90 days notice in writing. All deprecations are logged here — not in a newsletter, not in a forum post, not buried in release notes on a third-party platform.
      </p>
    </div>
  </section>

</SubPage>

<style>
/* ─── Release list ────────────────────────────────────────────────── */
.changelog-section {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}

.changelog__inner {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
}

.changelog__entries {
  display: flex;
  flex-direction: column;
}

/* Individual entry */
.changelog-entry {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  padding: 40px 0;
  border-bottom: 1px solid var(--line);
  align-items: start;
}

.changelog-entry__rail {
  padding-top: 4px;
}

.changelog-entry__version {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  font-weight: 600;
  color: var(--accent);
  letter-spacing: 0.3px;
  margin-bottom: 6px;
}

.changelog-entry__date {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--fg-mute);
  letter-spacing: 0.5px;
}

.changelog-entry__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 22px;
  font-weight: 500;
  letter-spacing: -0.4px;
  margin-bottom: 20px;
}

/* Change list */
.change-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.change-list__item {
  display: flex;
  gap: 12px;
  font-size: 14px;
  line-height: 1.55;
  align-items: baseline;
}

.change-list__item::before {
  content: '—';
  color: var(--fg-mute);
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  flex-shrink: 0;
}

.change-list__type {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.5px;
  flex-shrink: 0;
  padding-top: 2px;
}

.change-list__text {
  color: var(--fg-dim);
}

/* ─── Policy section ──────────────────────────────────────────────── */
.changelog-policy-section {
  padding: var(--sec-y-sm) var(--pad-x);
}

.changelog-policy__inner {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
}

.changelog-policy__body {
  font-size: 15px;
  line-height: 1.65;
  color: var(--fg-dim);
  max-width: 640px;
}

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 999px) {
  .changelog__inner,
  .changelog-policy__inner { grid-template-columns: 1fr; }
  .changelog-entry { grid-template-columns: 1fr; gap: 16px; }
  .changelog-entry__rail { display: flex; gap: 16px; align-items: baseline; }
}

@media (max-width: 767px) {
  .changelog-entry { padding: 32px 0; }
  .change-list__item { flex-wrap: wrap; gap: 6px; }
}
</style>
