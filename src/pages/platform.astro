---
import SubPage from '../layouts/SubPage.astro';
import { platform } from '../data/platform';

export const prerender = true;
---

<SubPage
  title="Platform Services — 0815software"
  description="Five shared backend services — identity, workflow, notifications, AI and integrations — consumed by the Business Modules over APIs."
  section="§ P4"
  sectionName="Platform"
  eyebrow="DIN 0815/S · PLATFORM SERVICES"
  heading="What modules run on."
  lead="Five shared backend services. Reusable capabilities the modules consume over APIs — never the other way around."
>

  <!-- Service grid -->
  <section class="modules-grid-section">
    <div class="modules-grid__head">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">§ P4.01</div>
        <div class="section-rail__name">Catalogue</div>
      </div>
      <p class="modules-grid__intro">
        Platform Services are shared backend capabilities — each does one cross-cutting job and exposes it over an API. A module may depend on several; a service never depends on a module. All ship MIT-licensed with full source code.
      </p>
    </div>

    <div class="platform-grid">
      {platform.map((svc) => (
        <article class="svc-card">
          <a class="svc-card__link" href={`/platform/${svc.slug}`} aria-label={`${svc.title} — details`}>
            <div class="svc-card__num">
              {svc.n}
              <span class={`svc-card__status svc-card__status--${svc.status.toLowerCase()}`}>{svc.status}</span>
            </div>
            <h2 class="svc-card__title">{svc.title}</h2>
            <p class="svc-card__body">{svc.purpose}</p>
          </a>
          <div class="svc-card__meta">
            <span>PORT · {svc.port}</span>
            <a class="svc-card__source" href={`/platform/${svc.slug}`}>DETAILS →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Architecture note -->
  <section class="modules-cta-section">
    <div class="modules-cta__inner">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">§ P4.02</div>
        <div class="section-rail__name">Architecture</div>
      </div>
      <div class="modules-cta__content">
        <h2 class="modules-cta__h2">Business Modules → Platform Services → Infrastructure</h2>
        <p class="modules-cta__body">
          Dependencies point strictly downward. <a href="/modules">Business Modules</a> are customer-facing applications; Platform Services are the reusable backend capabilities they compose. Services may depend on each other and on infrastructure — never on a module.
        </p>
        <a href="/modules" class="btn btn--ghost">Browse modules →</a>
      </div>
    </div>
  </section>

</SubPage>

<style>
/* ─── Grid section (shared vocabulary with /modules) ──────────────── */
.modules-grid-section {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}
.modules-grid__head {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  margin-bottom: 64px;
  align-items: start;
}
.modules-grid__intro {
  font-size: 15px;
  line-height: 1.65;
  color: var(--fg-dim);
  max-width: 640px;
}

.platform-grid {
  display: grid;
  grid-template-columns: 120px repeat(2, 1fr);
  gap: 0;
}
.platform-grid > :first-child { grid-column: 1 / -1; }

/* Service card */
.svc-card {
  padding: 28px 28px 28px 0;
  border-top: 1px solid var(--line);
  border-right: 1px solid var(--line);
}
.svc-card:nth-child(2n) { border-right: none; }

.svc-card__link { display: block; }
.svc-card__link:hover .svc-card__title { opacity: 0.7; }
.svc-card__title { transition: opacity 100ms ease-out; }

.svc-card__num {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.8px;
  margin-bottom: 16px;
}
.svc-card__status {
  font-size: 10px;
  letter-spacing: 0.6px;
  padding: 2px 8px;
  border: 1px solid var(--line-strong);
  border-radius: 2px;
  color: var(--fg-mute);
}
.svc-card__status--available { color: var(--fg); }

.svc-card__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 22px;
  font-weight: 500;
  letter-spacing: -0.4px;
  margin-bottom: 12px;
}
.svc-card__body {
  font-size: 14px;
  line-height: 1.6;
  color: var(--fg-dim);
  margin-bottom: 24px;
}
.svc-card__meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--fg-mute);
  letter-spacing: 0.8px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}
.svc-card__source {
  color: var(--accent);
  transition: opacity 100ms ease-out;
}
.svc-card__source:hover { opacity: 0.8; }

/* ─── Architecture note (reuses the CTA layout) ───────────────────── */
.modules-cta-section { padding: var(--sec-y-sm) var(--pad-x); }
.modules-cta__inner {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
}
.modules-cta__h2 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 30px;
  font-weight: 500;
  letter-spacing: -0.6px;
  line-height: 1.2;
  margin-bottom: 20px;
}
.modules-cta__body {
  font-size: 15px;
  line-height: 1.65;
  color: var(--fg-dim);
  max-width: 560px;
  margin-bottom: 32px;
}
.modules-cta__body a { color: var(--accent); }

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 999px) {
  .modules-grid__head { grid-template-columns: 1fr; gap: 32px; }
  .platform-grid { grid-template-columns: repeat(2, 1fr); }
  .modules-cta__inner { grid-template-columns: 1fr; }
}
@media (max-width: 767px) {
  .platform-grid { grid-template-columns: 1fr; }
  .svc-card { border-right: none !important; padding: 24px 0; }
  .modules-cta__h2 { font-size: 24px; }
}
</style>
