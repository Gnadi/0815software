---
import SubPage from '../../layouts/SubPage.astro';
import { getModule, type ModuleEntry } from '../../data/modules';
import { useCases, type UseCase } from '../../data/use-cases';
import { T } from '../../i18n/translations';

export const prerender = true;

// One page per example business. The landing page lists them (§07); this page
// tells the whole case: a day in practice, what it has solved, what each module
// does there, and what could follow later.
export function getStaticPaths() {
  return useCases.map((uc, i) => ({
    params: { id: uc.id },
    props: {
      uc,
      prev: useCases[(i - 1 + useCases.length) % useCases.length],
      next: useCases[(i + 1) % useCases.length],
    },
  }));
}

const { uc, prev, next } = Astro.props as { uc: UseCase; prev: UseCase; next: UseCase };

// Every string on this page is a dictionary key (src/i18n/use-cases.ts). The
// English entry is what gets rendered and indexed; the toggle swaps in the
// German one. A key missing in either language fails the build here rather
// than silently staying English on the client.
function t(key: string): string {
  const en = T.en[key];
  if (en === undefined || T.de[key] === undefined) {
    throw new Error(`use-cases/[id].astro: "${key}" is missing in ${en === undefined ? 'en' : 'de'}`);
  }
  return en;
}

function mod(slug: string): ModuleEntry {
  return getModule(slug)!; // slugs are validated in src/data/use-cases.ts
}

const k = (suffix: string) => `uc.${uc.id}.${suffix}`;
const range = (n: number) => Array.from({ length: n }, (_, i) => i);
const rail = (i: number) => `§ ${uc.n}.${String(i).padStart(2, '0')}`;
---

<SubPage
  title={`${t(k('title'))} — Use Cases — 0815software`}
  description={t(k('teaser'))}
  section={`§ ${uc.n}`}
  sectionName={t('page.uc.rail')}
  eyebrow={t(k('profile'))}
  heading={t(k('title'))}
  lead={t(k('teaser'))}
  i18n={{
    sectionName: 'page.uc.rail',
    eyebrow: k('profile'),
    heading: k('title'),
    lead: k('teaser'),
  }}
>

  <!-- A day in practice -->
  <section class="uc-sec">
    <div class="uc-grid">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">{rail(1)}</div>
        <div class="section-rail__name" data-i18n="page.uc.rail.story">{t('page.uc.rail.story')}</div>
      </div>
      <div>
        <p class="uc-label">
          <a class="uc-back" href="/#use-cases" data-i18n="page.uc.back">{t('page.uc.back')}</a>
          <span>{uc.n} · <span data-i18n="page.uc.label.example">{t('page.uc.label.example')}</span> · <span data-i18n={k('sector')}>{t(k('sector'))}</span></span>
        </p>
        <h2 class="uc-h2" data-i18n="page.uc.story.h">{t('page.uc.story.h')}</h2>
        <p class="uc-ready">
          <span class="uc-ready__mark" aria-hidden="true">✓</span>
          <span data-i18n="page.uc.ready">{t('page.uc.ready')}</span>
        </p>
        <p class="uc-story__text" data-i18n-html={k('story')} set:html={t(k('story'))} />
        <p class="uc-story__note" data-i18n="page.uc.today.note">{t('page.uc.today.note')}</p>
        <p class="uc-example" data-i18n="page.uc.example.note">{t('page.uc.example.note')}</p>
      </div>
    </div>
  </section>

  <!-- What is solved: problem → solution, one module each -->
  <section class="uc-sec uc-sec--alt">
    <div class="uc-grid">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">{rail(2)}</div>
        <div class="section-rail__name" data-i18n="page.uc.rail.solved">{t('page.uc.rail.solved')}</div>
      </div>
      <div>
        <h2 class="uc-h2" data-i18n="page.uc.solved.h">{t('page.uc.solved.h')}</h2>
        <ol class="uc-solved">
          {uc.solved.map((slug, n) => (
            <li class="uc-solved__item">
              <p class="uc-solved__before">
                <span class="uc-solved__tag" data-i18n="page.uc.before">{t('page.uc.before')}</span>
                <span data-i18n={k(`solved.${n}.before`)}>{t(k(`solved.${n}.before`))}</span>
              </p>
              <p class="uc-solved__after">
                <span class="uc-solved__tag uc-solved__tag--today" data-i18n="page.uc.after">{t('page.uc.after')}</span>
                <span data-i18n={k(`solved.${n}.after`)}>{t(k(`solved.${n}.after`))}</span>
              </p>
              <a class="uc-solved__mod" href={`/modules/${slug}`}>
                {mod(slug).n} · <span data-i18n={`mod.${slug}.title`}>{mod(slug).title}</span> →
              </a>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Setup: every module in use and what it does in this business -->
  <section class="uc-sec">
    <div class="uc-grid">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">{rail(3)}</div>
        <div class="section-rail__name" data-i18n="page.uc.rail.setup">{t('page.uc.rail.setup')}</div>
      </div>
      <div>
        <h2 class="uc-h2" data-i18n="page.uc.setup.h">{t('page.uc.setup.h')}</h2>
        <p class="uc-intro" data-i18n="page.uc.setup.note">{t('page.uc.setup.note')}</p>
        <ul class="uc-setup">
          {uc.uses.map((slug) => (
            <li>
              <a class="uc-setup__item" href={`/modules/${slug}`}>
                <span class="uc-setup__num">{mod(slug).n}</span>
                <span class="uc-setup__title" data-i18n={`mod.${slug}.title`}>{mod(slug).title}</span>
                <span class="uc-setup__body" data-i18n={k(`use.${slug}`)}>{t(k(`use.${slug}`))}</span>
                <span class="uc-setup__more" data-i18n="page.uc.setup.more">{t('page.uc.setup.more')}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Optional, later -->
  <section class="uc-sec uc-sec--alt">
    <div class="uc-grid">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">{rail(4)}</div>
        <div class="section-rail__name" data-i18n="page.uc.rail.later">{t('page.uc.rail.later')}</div>
      </div>
      <div>
        <h2 class="uc-h2" data-i18n="page.uc.potential">{t('page.uc.potential')}</h2>
        <p class="uc-intro" data-i18n="page.uc.potential.note">{t('page.uc.potential.note')}</p>
        <div class="uc-potential">
          <div class="uc-pot">
            <h3 class="uc-pot__h"><span class="uc-dot" aria-hidden="true"></span> <span data-i18n="page.uc.next">{t('page.uc.next')}</span></h3>
            <ul class="uc-pot__list">
              {uc.next.map((slug) => (
                <li>
                  <a class="uc-pot__mod" href={`/modules/${slug}`}>
                    <span class="uc-pot__title">{mod(slug).n} · <span data-i18n={`mod.${slug}.title`}>{mod(slug).title}</span> <span aria-hidden="true">→</span></span>
                    <span class="uc-pot__body" data-i18n={k(`next.${slug}`)}>{t(k(`next.${slug}`))}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div class="uc-pot">
            <h3 class="uc-pot__h" data-i18n="page.uc.custom">{t('page.uc.custom')}</h3>
            <p class="uc-pot__note" data-i18n="page.uc.custom.note">{t('page.uc.custom.note')}</p>
            <ul class="uc-pot__list">
              {range(uc.custom).map((c) => (
                <li class="uc-pot__item">
                  <span class="uc-pot__title" data-i18n={k(`custom.${c}.title`)}>{t(k(`custom.${c}.title`))}</span>
                  <span class="uc-pot__body" data-i18n={k(`custom.${c}.body`)}>{t(k(`custom.${c}.body`))}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="uc-pot">
            <h3 class="uc-pot__h" data-i18n="page.uc.ai">{t('page.uc.ai')}</h3>
            <p class="uc-pot__note">
              <a href="/platform/ai-platform" data-i18n="page.uc.ai.note">{t('page.uc.ai.note')}</a>
            </p>
            <ul class="uc-pot__list uc-pot__list--plain">
              {range(uc.ai).map((a) => (
                <li class="uc-pot__ai" data-i18n={k(`ai.${a}`)}>{t(k(`ai.${a}`))}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="uc-sec">
    <div class="uc-grid">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">{rail(5)}</div>
        <div class="section-rail__name" data-i18n="page.uc.cta.rail">{t('page.uc.cta.rail')}</div>
      </div>
      <div class="uc-cta__content">
        <div>
          <h2 class="uc-cta__h2" data-i18n="page.uc.cta.h2">{t('page.uc.cta.h2')}</h2>
          <p class="uc-cta__body" data-i18n="page.uc.cta.body">{t('page.uc.cta.body')}</p>
          <div class="uc-cta__actions">
            <a href="/#contact" class="btn btn--primary" data-i18n="page.uc.cta.quote">{t('page.uc.cta.quote')}</a>
            <a href="/demo" class="btn btn--ghost" data-i18n="page.uc.cta.demo">{t('page.uc.cta.demo')}</a>
            <a href="/#use-cases" class="btn btn--ghost" data-i18n="page.uc.back">{t('page.uc.back')}</a>
          </div>
        </div>
        <aside class="uc-review">
          <h3 class="uc-review__h" data-i18n="page.uc.review.h">{t('page.uc.review.h')}</h3>
          <p class="uc-review__body" data-i18n="page.uc.review.body">{t('page.uc.review.body')}</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- Prev / Next -->
  <nav class="uc-nav" aria-label="Use case navigation">
    <a href={`/use-cases/${prev.id}`} class="uc-nav__link">
      <span class="uc-nav__dir" data-i18n="detail.prev">← PREVIOUS</span>
      <span class="uc-nav__title">{prev.n} · <span data-i18n={`uc.${prev.id}.title`}>{t(`uc.${prev.id}.title`)}</span></span>
    </a>
    <a href={`/use-cases/${next.id}`} class="uc-nav__link uc-nav__link--next">
      <span class="uc-nav__dir" data-i18n="detail.next">NEXT →</span>
      <span class="uc-nav__title">{next.n} · <span data-i18n={`uc.${next.id}.title`}>{t(`uc.${next.id}.title`)}</span></span>
    </a>
  </nav>

</SubPage>

<style>
/* ─── Shared ──────────────────────────────────────────────────────── */
.uc-sec {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}
.uc-sec--alt { background: var(--bg-2); }

.uc-grid {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
}
.uc-grid > * { min-width: 0; }

.uc-h2 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 36px;
  font-weight: 500;
  line-height: 1.1;
  letter-spacing: -0.8px;
  max-width: 820px;
  margin-bottom: 20px;
}

.uc-intro {
  font-size: 15px;
  line-height: 1.6;
  color: var(--fg-dim);
  max-width: 640px;
  margin-bottom: 32px;
}

.uc-label {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 24px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--fg-mute);
  letter-spacing: 0.8px;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.uc-back {
  color: var(--accent);
  text-decoration: underline;
  text-decoration-color: var(--line-strong);
  text-underline-offset: 3px;
}
.uc-back:hover { text-decoration-color: var(--fg); }

/* Optional later = outlined dot, as on the module pages. */
.uc-dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  border: 1px solid var(--fg-dim);
}

/* ─── Story ───────────────────────────────────────────────────────── */
/* The claim the case makes, set as a stamp: what you see here exists. */
.uc-ready {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 7px 12px;
  margin-bottom: 40px;
  background: var(--fg);
  color: var(--bg);
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.8px;
}
.uc-ready__mark { font-size: 12px; }

/* The story is the case: prose, with each module linked where it does its part. */
.uc-story__text {
  font-size: 19px;
  line-height: 1.7;
  color: var(--fg-dim);
  max-width: 760px;
}
.uc-story__text :global(a) {
  color: var(--fg);
  text-decoration: underline;
  text-decoration-color: var(--line-strong);
  text-decoration-thickness: 1px;
  text-underline-offset: 4px;
  transition: text-decoration-color 100ms ease-out;
}
.uc-story__text :global(a:hover) { text-decoration-color: var(--fg); }

.uc-story__note {
  margin-top: 24px;
  padding-top: 16px;
  border-top: 1px solid var(--line);
  font-size: 14px;
  line-height: 1.55;
  color: var(--fg);
  max-width: 760px;
}

.uc-example {
  margin-top: 12px;
  font-size: 13px;
  line-height: 1.55;
  color: var(--fg-mute);
  max-width: 760px;
}

/* ─── Solved ──────────────────────────────────────────────────────── */
.uc-solved {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
  margin-top: 12px;
}

.uc-solved__item {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 24px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  background: var(--bg);
}

.uc-solved__before,
.uc-solved__after {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 15px;
  line-height: 1.5;
}
.uc-solved__before { color: var(--fg-mute); }
.uc-solved__after { color: var(--fg); flex: 1; }

.uc-solved__tag {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.8px;
  text-transform: uppercase;
}
.uc-solved__tag--today { color: var(--accent); font-weight: 600; }

.uc-solved__mod {
  padding-top: 12px;
  border-top: 1px solid var(--line);
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.6px;
}
.uc-solved__mod:hover { color: var(--fg); }

/* ─── Setup ───────────────────────────────────────────────────────── */
.uc-setup {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
}

.uc-setup li { display: flex; }

.uc-setup__item {
  display: grid;
  grid-template-columns: 64px 1fr;
  grid-template-areas: 'num title' '. body' '. more';
  gap: 6px 0;
  width: 100%;
  padding: 22px 24px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  transition: background 100ms ease-out;
}
.uc-setup__item:hover { background: var(--bg-2); }
.uc-setup__item:hover .uc-setup__more { color: var(--fg); }

.uc-setup__num {
  grid-area: num;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--accent);
  letter-spacing: 0.8px;
  padding-top: 5px;
}

.uc-setup__title {
  grid-area: title;
  font-family: 'Inter Tight', sans-serif;
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.3px;
}

.uc-setup__body {
  grid-area: body;
  font-size: 14px;
  line-height: 1.55;
  color: var(--fg-dim);
}

.uc-setup__more {
  grid-area: more;
  margin-top: 6px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  color: var(--accent);
  transition: color 100ms ease-out;
}

/* ─── Optional, later ─────────────────────────────────────────────── */
.uc-potential {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid var(--line);
  background: var(--bg);
}

.uc-pot {
  padding: 24px 28px;
  border-right: 1px solid var(--line);
}
.uc-pot:last-child { border-right: none; }

.uc-pot__h {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Inter Tight', sans-serif;
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.3px;
  margin-bottom: 8px;
}

.uc-pot__note {
  font-size: 13px;
  line-height: 1.5;
  color: var(--fg-mute);
  margin-bottom: 8px;
}
.uc-pot__note a {
  text-decoration: underline;
  text-decoration-color: var(--line-strong);
  text-underline-offset: 3px;
}
.uc-pot__note a:hover { color: var(--fg); text-decoration-color: var(--fg); }

.uc-pot__list { display: flex; flex-direction: column; }

.uc-pot__mod,
.uc-pot__item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px 0;
  border-bottom: 1px solid var(--line);
}
.uc-pot__list li:last-child > .uc-pot__mod,
.uc-pot__list li.uc-pot__item:last-child { border-bottom: none; padding-bottom: 0; }

.uc-pot__mod:hover .uc-pot__title { opacity: 0.7; }

.uc-pot__title {
  font-size: 14px;
  font-weight: 500;
  color: var(--fg);
  transition: opacity 100ms ease-out;
}

.uc-pot__body { font-size: 13px; line-height: 1.5; color: var(--fg-dim); }

.uc-pot__ai {
  position: relative;
  padding: 10px 0 10px 18px;
  font-size: 14px;
  line-height: 1.5;
  color: var(--fg-dim);
  border-bottom: 1px solid var(--line);
}
.uc-pot__ai:last-child { border-bottom: none; padding-bottom: 0; }
.uc-pot__ai::before {
  content: '—';
  position: absolute;
  left: 0;
  color: var(--fg-mute);
}

/* ─── CTA ─────────────────────────────────────────────────────────── */
.uc-cta__content {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 64px;
  align-items: start;
}

.uc-cta__h2 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 36px;
  font-weight: 500;
  letter-spacing: -0.8px;
  margin-bottom: 20px;
}

.uc-cta__body {
  font-size: 15px;
  line-height: 1.65;
  color: var(--fg-dim);
  max-width: 560px;
  margin-bottom: 32px;
}

.uc-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }

.uc-review {
  border: 1px solid var(--line-strong);
  padding: 24px 28px;
}

.uc-review__h {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  font-weight: 400;
  color: var(--accent);
  letter-spacing: 0.8px;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.uc-review__body { font-size: 14px; line-height: 1.6; color: var(--fg-dim); }

/* ─── Prev / Next ─────────────────────────────────────────────────── */
.uc-nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-bottom: 1px solid var(--line);
}
.uc-nav__link {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 40px var(--pad-x);
  transition: background 120ms ease-out;
}
.uc-nav__link:hover { background: var(--bg-2); }
.uc-nav__link--next {
  align-items: flex-end;
  text-align: right;
  border-left: 1px solid var(--line);
}
.uc-nav__dir {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.8px;
  color: var(--fg-mute);
}
.uc-nav__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.3px;
  color: var(--fg);
}

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1199px) {
  .uc-grid { gap: 32px; }
  .uc-potential { grid-template-columns: 1fr 1fr; }
  .uc-pot:nth-child(2) { border-right: none; }
  .uc-pot:last-child { grid-column: 1 / -1; border-top: 1px solid var(--line); }
  .uc-cta__content { grid-template-columns: 1fr; gap: 40px; }
  .uc-review { max-width: 560px; }
}

@media (max-width: 999px) {
  .uc-grid { grid-template-columns: 1fr; }
  .uc-solved { grid-template-columns: 1fr; }
}

@media (max-width: 767px) {
  .uc-h2 { font-size: 28px; letter-spacing: -0.6px; }
  .uc-story__text { font-size: 17px; }
  .uc-ready { margin-bottom: 32px; }
  .uc-setup { grid-template-columns: 1fr; }
  .uc-setup__item { grid-template-columns: 1fr; grid-template-areas: 'num' 'title' 'body' 'more'; padding: 20px; }
  .uc-potential { grid-template-columns: 1fr; }
  .uc-pot { border-right: none; border-top: 1px solid var(--line); padding: 20px; }
  .uc-pot:first-child { border-top: none; }
  .uc-cta__h2 { font-size: 28px; }
  .uc-cta__actions .btn { width: 100%; justify-content: center; }
  .uc-nav { grid-template-columns: 1fr; }
  .uc-nav__link--next {
    align-items: flex-start;
    text-align: left;
    border-left: none;
