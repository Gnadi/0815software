---
import SubPage from '../layouts/SubPage.astro';
import { modules, getModule, type ModuleEntry } from '../data/modules';
import { useCases } from '../data/use-cases';
import { T } from '../i18n/translations';

export const prerender = true;

// Every string on this page is a dictionary key (src/i18n/use-cases.ts). The
// English entry is what gets rendered and indexed; the toggle swaps in the
// German one. A key missing in either language fails the build here rather
// than silently staying English on the client.
function t(key: string): string {
  const en = T.en[key];
  if (en === undefined || T.de[key] === undefined) {
    throw new Error(`use-cases.astro: "${key}" is missing in ${en === undefined ? 'en' : 'de'}`);
  }
  return en;
}

function mod(slug: string): ModuleEntry {
  return getModule(slug)!; // slugs are validated in src/data/use-cases.ts
}

const pad = (i: number) => String(i + 1).padStart(2, '0');
const range = (n: number) => Array.from({ length: n }, (_, i) => i);

// The overview matrix: a module that no business uses and none could add is
// left out, so every row says something.
const matrix = modules
  .map((m) => ({
    m,
    cells: useCases.map((uc) => (uc.uses.includes(m.slug) ? 'used' : uc.next.includes(m.slug) ? 'next' : '')),
  }))
  .filter((row) => row.cells.some(Boolean));
---

<SubPage
  title="Use Cases — 0815software"
  description="Six example businesses — a restaurant, a tradesman, a tax office, a wholesaler, an agency and a non-profit — and how they combine the same standard modules, with what is still open for each."
  section="§ P6"
  sectionName={t('page.uc.rail')}
  eyebrow={t('page.uc.eyebrow')}
  heading={t('page.uc.heading')}
  lead={t('page.uc.lead')}
  i18n={{
    sectionName: 'page.uc.rail',
    eyebrow: 'page.uc.eyebrow',
    heading: 'page.uc.heading',
    lead: 'page.uc.lead',
  }}
>

  <!-- Overview: the six businesses and the module matrix -->
  <section class="uc-overview">
    <div class="uc-grid">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">§ P6.01</div>
        <div class="section-rail__name" data-i18n="page.uc.rail.overview">{t('page.uc.rail.overview')}</div>
      </div>
      <div>
        <p class="uc-overview__intro" data-i18n="page.uc.intro">{t('page.uc.intro')}</p>

        <nav class="uc-index" aria-label="Use cases">
          {useCases.map((uc) => (
            <a class="uc-index__item" href={`#${uc.id}`}>
              <span class="uc-index__label">{uc.n} · <span data-i18n={`uc.${uc.id}.sector`}>{t(`uc.${uc.id}.sector`)}</span></span>
              <span class="uc-index__title" data-i18n={`uc.${uc.id}.title`}>{t(`uc.${uc.id}.title`)}</span>
              <span class="uc-index__profile" data-i18n={`uc.${uc.id}.profile`}>{t(`uc.${uc.id}.profile`)}</span>
            </a>
          ))}
        </nav>

        <div class="uc-matrix">
          <div class="uc-matrix__head">
            <h2 class="uc-matrix__h" data-i18n="page.uc.matrix.h">{t('page.uc.matrix.h')}</h2>
            <p class="uc-matrix__legend">
              <span><span class="uc-dot uc-dot--used" aria-hidden="true"></span> <span data-i18n="page.uc.matrix.used">{t('page.uc.matrix.used')}</span></span>
              <span><span class="uc-dot uc-dot--next" aria-hidden="true"></span> <span data-i18n="page.uc.matrix.next">{t('page.uc.matrix.next')}</span></span>
            </p>
          </div>
          <div class="uc-matrix__scroll" tabindex="0" role="region" aria-label="Modules by use case">
            <table class="uc-table">
              <thead>
                <tr>
                  <th scope="col" data-i18n="page.uc.matrix.module">{t('page.uc.matrix.module')}</th>
                  {useCases.map((uc) => (
                    <th scope="col">
                      <a href={`#${uc.id}`}>
                        <span class="uc-table__n">{uc.n}</span>
                        <span class="uc-table__sector" data-i18n={`uc.${uc.id}.sector`}>{t(`uc.${uc.id}.sector`)}</span>
                      </a>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {matrix.map(({ m, cells }) => (
                  <tr>
                    <th scope="row">
                      <a href={`/modules/${m.slug}`}>
                        <span class="uc-table__n">{m.n}</span>
                        <span data-i18n={`mod.${m.slug}.title`}>{m.title}</span>
                      </a>
                    </th>
                    {cells.map((cell) => (
                      <td>
                        {cell === 'used' && (
                          <span class="uc-dot uc-dot--used" role="img" aria-label={t('page.uc.matrix.used')}></span>
                        )}
                        {cell === 'next' && (
                          <span class="uc-dot uc-dot--next" role="img" aria-label={t('page.uc.matrix.next')}></span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- One section per business -->
  {useCases.map((uc, i) => (
    <section id={uc.id} class:list={['uc-case', { 'uc-case--alt': i % 2 === 1 }]}>
      <div class="uc-grid">
        <div class="section-rail" aria-hidden="true">
          <div class="section-rail__num">§ P6.{pad(i + 1)}</div>
          <div class="section-rail__name" data-i18n={`uc.${uc.id}.sector`}>{t(`uc.${uc.id}.sector`)}</div>
        </div>
        <div>
          <p class="uc-case__label">
            {uc.n} · <span data-i18n="page.uc.label.example">{t('page.uc.label.example')}</span> · <span data-i18n={`uc.${uc.id}.profile`}>{t(`uc.${uc.id}.profile`)}</span>
          </p>
          <h2 class="uc-case__title" data-i18n={`uc.${uc.id}.title`}>{t(`uc.${uc.id}.title`)}</h2>

          <div class="uc-case__top">
            <div>
              <h3 class="uc-key" data-i18n="page.uc.situation">{t('page.uc.situation')}</h3>
              <p class="uc-case__situation" data-i18n={`uc.${uc.id}.situation`}>{t(`uc.${uc.id}.situation`)}</p>
            </div>
            <div class="uc-flow">
              <h3 class="uc-key" data-i18n="page.uc.flow">{t('page.uc.flow')}</h3>
              <ol class="uc-flow__list">
                {uc.flow.map((slug, s) => (
                  <li class="uc-flow__step">
                    <span class="uc-flow__idx" aria-hidden="true">{pad(s)}</span>
                    <span class="uc-flow__body">
                      <a class="uc-flow__mod" href={`/modules/${slug}`}>
                        {mod(slug).n} · <span data-i18n={`mod.${slug}.title`}>{mod(slug).title}</span>
                      </a>
                      <span class="uc-flow__text" data-i18n={`uc.${uc.id}.flow.${s}`}>{t(`uc.${uc.id}.flow.${s}`)}</span>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          </div>

          <h3 class="uc-key" data-i18n="page.uc.uses">{t('page.uc.uses')}</h3>
          <ul class="uc-mods">
            {uc.uses.map((slug) => (
              <li>
                <a class="uc-mod" href={`/modules/${slug}`}>
                  <span class="uc-mod__num">{mod(slug).n}</span>
                  <span class="uc-mod__text">
                    <span class="uc-mod__title" data-i18n={`mod.${slug}.title`}>{mod(slug).title}</span>
                    <span class="uc-mod__use" data-i18n={`uc.${uc.id}.use.${slug}`}>{t(`uc.${uc.id}.use.${slug}`)}</span>
                  </span>
                  <span class="uc-mod__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>

          <h3 class="uc-key" data-i18n="page.uc.potential">{t('page.uc.potential')}</h3>
          <div class="uc-potential">
            <div class="uc-pot">
              <h4 class="uc-pot__h"><span class="uc-dot uc-dot--next" aria-hidden="true"></span> <span data-i18n="page.uc.next">{t('page.uc.next')}</span></h4>
              <ul class="uc-pot__list">
                {uc.next.map((slug) => (
                  <li>
                    <a class="uc-pot__mod" href={`/modules/${slug}`}>
                      <span class="uc-pot__title">{mod(slug).n} · <span data-i18n={`mod.${slug}.title`}>{mod(slug).title}</span> <span aria-hidden="true">→</span></span>
                      <span class="uc-pot__body" data-i18n={`uc.${uc.id}.next.${slug}`}>{t(`uc.${uc.id}.next.${slug}`)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="uc-pot">
              <h4 class="uc-pot__h" data-i18n="page.uc.custom">{t('page.uc.custom')}</h4>
              <p class="uc-pot__note" data-i18n="page.uc.custom.note">{t('page.uc.custom.note')}</p>
              <ul class="uc-pot__list">
                {range(uc.custom).map((c) => (
                  <li class="uc-pot__item">
                    <span class="uc-pot__title" data-i18n={`uc.${uc.id}.custom.${c}.title`}>{t(`uc.${uc.id}.custom.${c}.title`)}</span>
                    <span class="uc-pot__body" data-i18n={`uc.${uc.id}.custom.${c}.body`}>{t(`uc.${uc.id}.custom.${c}.body`)}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="uc-pot">
              <h4 class="uc-pot__h" data-i18n="page.uc.ai">{t('page.uc.ai')}</h4>
              <p class="uc-pot__note">
                <a href="/platform/ai-platform" data-i18n="page.uc.ai.note">{t('page.uc.ai.note')}</a>
              </p>
              <ul class="uc-pot__list uc-pot__list--plain">
                {range(uc.ai).map((a) => (
                  <li class="uc-pot__ai" data-i18n={`uc.${uc.id}.ai.${a}`}>{t(`uc.${uc.id}.ai.${a}`)}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="uc-cta">
    <div class="uc-grid">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">§ P6.{pad(useCases.length + 1)}</div>
        <div class="section-rail__name" data-i18n="page.uc.cta.rail">{t('page.uc.cta.rail')}</div>
      </div>
      <div class="uc-cta__content">
        <div>
          <h2 class="uc-cta__h2" data-i18n="page.uc.cta.h2">{t('page.uc.cta.h2')}</h2>
          <p class="uc-cta__body" data-i18n="page.uc.cta.body">{t('page.uc.cta.body')}</p>
          <div class="uc-cta__actions">
            <a href="/#contact" class="btn btn--primary" data-i18n="detail.startProject">{t('detail.startProject')}</a>
            <a href="/demo" class="btn btn--ghost" data-i18n="page.uc.cta.demo">{t('page.uc.cta.demo')}</a>
            <a href="/modules" class="btn btn--ghost" data-i18n="page.uc.cta.modules">{t('page.uc.cta.modules')}</a>
          </div>
        </div>
        <aside class="uc-review">
          <h3 class="uc-review__h" data-i18n="page.uc.review.h">{t('page.uc.review.h')}</h3>
          <p class="uc-review__body" data-i18n="page.uc.review.body">{t('page.uc.review.body')}</p>
        </aside>
      </div>
    </div>
  </section>

</SubPage>

<style>
/* ─── Shared ──────────────────────────────────────────────────────── */
.uc-grid {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
}
/* Let wide content (the matrix) scroll in its box instead of widening the page. */
.uc-grid > * { min-width: 0; }

.uc-key {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 400;
  color: var(--fg-mute);
  letter-spacing: 1px;
  margin-bottom: 16px;
}

/* In use = filled, potential = outlined: told apart by fill, not by hue. */
.uc-dot {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-radius: 50%;
  vertical-align: middle;
}
.uc-dot--used { background: var(--fg); }
.uc-dot--next { border: 1px solid var(--fg-dim); }

/* ─── Overview ────────────────────────────────────────────────────── */
.uc-overview {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}

.uc-overview__intro {
  font-size: 16px;
  line-height: 1.65;
  color: var(--fg-dim);
  max-width: 720px;
  margin-bottom: 48px;
}

.uc-index {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--line);
  border-left: 1px solid var(--line);
  margin-bottom: 72px;
}

.uc-index__item {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 22px 24px;
  border-right: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  transition: background 100ms ease-out;
}
.uc-index__item:hover { background: var(--bg-2); }

.uc-index__label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--accent);
  letter-spacing: 1px;
}

.uc-index__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.3px;
  line-height: 1.25;
}

.uc-index__profile {
  font-size: 13px;
  color: var(--fg-mute);
}

.uc-matrix__head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16px;
  margin-bottom: 20px;
}

.uc-matrix__h {
  font-family: 'Inter Tight', sans-serif;
  font-size: 28px;
  font-weight: 500;
  letter-spacing: -0.6px;
}

.uc-matrix__legend {
  display: flex;
  gap: 24px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--fg-dim);
  letter-spacing: 0.5px;
}

.uc-matrix__scroll {
  overflow-x: auto;
  border: 1px solid var(--line);
}
.uc-matrix__scroll:focus-visible { outline: 2px solid var(--fg); outline-offset: 2px; }

.uc-table {
  width: 100%;
  min-width: 760px;
  border-collapse: collapse;
  font-size: 14px;
}

.uc-table th,
.uc-table td {
  padding: 12px 16px;
  border-bottom: 1px solid var(--line);
  text-align: center;
  font-weight: 400;
}
.uc-table tbody tr:last-child th,
.uc-table tbody tr:last-child td { border-bottom: none; }

.uc-table thead th {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--fg-mute);
  letter-spacing: 0.8px;
  vertical-align: bottom;
  background: var(--bg-2);
}
.uc-table thead th:first-child { text-align: left; }
.uc-table thead a { display: flex; flex-direction: column; gap: 4px; align-items: center; }
.uc-table thead a:hover .uc-table__sector { color: var(--fg); }

.uc-table tbody th { text-align: left; white-space: nowrap; }
.uc-table tbody th a { display: inline-flex; gap: 12px; align-items: baseline; color: var(--fg); }
.uc-table tbody th a:hover { opacity: 0.7; }
.uc-table tbody tr:hover { background: var(--bg-2); }

.uc-table__n {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--accent);
  letter-spacing: 0.8px;
}
.uc-table__sector { transition: color 100ms ease-out; }

/* ─── One business ────────────────────────────────────────────────── */
.uc-case {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}
.uc-case--alt { background: var(--bg-2); }

.uc-case__label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--fg-mute);
  letter-spacing: 0.8px;
  text-transform: uppercase;
  margin-bottom: 20px;
}

.uc-case__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 44px;
  font-weight: 500;
  line-height: 1.05;
  letter-spacing: -1.2px;
  max-width: 820px;
  margin-bottom: 48px;
}

.uc-case__top {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 48px;
  margin-bottom: 56px;
}

.uc-case__situation {
  font-size: 17px;
  line-height: 1.6;
  color: var(--fg-dim);
  max-width: 560px;
}

/* The flow reads like a slip: numbered steps on a dashed rule. */
.uc-flow {
  border: 1px solid var(--line-strong);
  padding: 24px 28px;
  background: var(--bg);
}

.uc-flow__list { display: flex; flex-direction: column; }

.uc-flow__step {
  display: grid;
  grid-template-columns: 32px 1fr;
  gap: 12px;
  padding: 14px 0;
  border-top: 1px dashed var(--line-strong);
}
.uc-flow__step:first-child { border-top: none; padding-top: 0; }
.uc-flow__step:last-child { padding-bottom: 0; }

.uc-flow__idx {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--fg-mute);
  padding-top: 2px;
}

.uc-flow__body { display: flex; flex-direction: column; gap: 4px; }

.uc-flow__mod {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.6px;
  text-decoration: underline;
  text-decoration-color: var(--line-strong);
  text-underline-offset: 3px;
  align-self: flex-start;
}
.uc-flow__mod:hover { text-decoration-color: var(--fg); }

.uc-flow__text { font-size: 15px; line-height: 1.5; color: var(--fg); }

/* Modules in use */
.uc-mods {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 48px;
  border-top: 1px solid var(--line);
  margin-bottom: 56px;
}

.uc-mod {
  display: flex;
  align-items: baseline;
  gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid var(--line);
  height: 100%;
  transition: padding-left 120ms ease-out;
}
.uc-mod:hover { padding-left: 8px; }
.uc-mod:hover .uc-mod__arrow { opacity: 1; }

.uc-mod__num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.6px;
  flex-shrink: 0;
  width: 52px;
}

.uc-mod__text { display: flex; flex-direction: column; gap: 4px; flex: 1; }

.uc-mod__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 16px;
  font-weight: 500;
  color: var(--fg);
}

.uc-mod__use { font-size: 14px; line-height: 1.5; color: var(--fg-dim); }

.uc-mod__arrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 14px;
  color: var(--accent);
  opacity: 0;
  transition: opacity 100ms ease-out;
}

/* Potential */
.uc-potential {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid var(--line-strong);
}

.uc-pot {
  padding: 24px 28px;
  border-right: 1px solid var(--line);
}
.uc-pot:last-child { border-right: none; }

.uc-pot__h {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'Inter Tight', sans-serif;
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.3px;
  margin-bottom: 8px;
}

.uc-pot__note {
  font-size: 13px;
  line-height: 1.5;
  color: var(--fg-mute);
  margin-bottom: 8px;
}
.uc-pot__note a {
  text-decoration: underline;
  text-decoration-color: var(--line-strong);
  text-underline-offset: 3px;
}
.uc-pot__note a:hover { color: var(--fg); text-decoration-color: var(--fg); }

.uc-pot__list { display: flex; flex-direction: column; }

.uc-pot__mod,
.uc-pot__item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px 0;
  border-bottom: 1px solid var(--line);
}
.uc-pot__list li:last-child > .uc-pot__mod,
.uc-pot__list li.uc-pot__item:last-child { border-bottom: none; padding-bottom: 0; }

.uc-pot__mod:hover .uc-pot__title { opacity: 0.7; }

.uc-pot__title {
  font-size: 14px;
  font-weight: 500;
  color: var(--fg);
  transition: opacity 100ms ease-out;
}

.uc-pot__body { font-size: 13px; line-height: 1.5; color: var(--fg-dim); }

.uc-pot__ai {
  position: relative;
  padding: 10px 0 10px 18px;
  font-size: 14px;
  line-height: 1.5;
  color: var(--fg-dim);
  border-bottom: 1px solid var(--line);
}
.uc-pot__ai:last-child { border-bottom: none; padding-bottom: 0; }
.uc-pot__ai::before {
  content: '—';
  position: absolute;
  left: 0;
  color: var(--fg-mute);
}

/* ─── CTA ─────────────────────────────────────────────────────────── */
.uc-cta { padding: var(--sec-y-sm) var(--pad-x); }

.uc-cta__content {
  display: grid;
  grid-template-columns: 1fr 360px;
  gap: 64px;
  align-items: start;
}

.uc-cta__h2 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 36px;
  font-weight: 500;
  letter-spacing: -0.8px;
  margin-bottom: 20px;
}

.uc-cta__body {
  font-size: 15px;
  line-height: 1.65;
  color: var(--fg-dim);
  max-width: 560px;
  margin-bottom: 32px;
}

.uc-cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }

.uc-review {
  border: 1px solid var(--line-strong);
  padding: 24px 28px;
}

.uc-review__h {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  font-weight: 400;
  color: var(--accent);
  letter-spacing: 0.8px;
  text-transform: uppercase;
  margin-bottom: 12px;
}

.uc-review__body { font-size: 14px; line-height: 1.6; color: var(--fg-dim); }

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1199px) {
