---
import SubPage from '../../layouts/SubPage.astro';
import { platform } from '../../data/platform';

export const prerender = true;

export function getStaticPaths() {
  return platform.map((svc, i) => ({
    params: { slug: svc.slug },
    props: {
      svc,
      prev: platform[(i - 1 + platform.length) % platform.length],
      next: platform[(i + 1) % platform.length],
    },
  }));
}

const { svc, prev, next } = Astro.props;
---

<SubPage
  title={`${svc.title} — Platform Services — 0815software`}
  description={svc.purpose}
  section="§ P4"
  sectionName="Platform"
  eyebrow={`DIN 0815/S · ${svc.n}`}
  heading={svc.title}
  lead={svc.purpose}
  i18n={{
    sectionName: 'page.rail.platform',
    heading: `svc.${svc.slug}.title`,
    lead: `svc.${svc.slug}.purpose`,
  }}
>

  <!-- Overview + responsibilities -->
  <section class="detail-body-section">
    <div class="detail-body__inner">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">§ P4.01</div>
        <div class="section-rail__name" data-i18n="page.rail.overview">Overview</div>
      </div>
      <div class="detail-body__content">
        <p class="detail-body__overview" data-i18n={`svc.${svc.slug}.overview`}>{svc.overview}</p>

        <div class="detail-meta">
          <div class="detail-meta__item">
            <span class="detail-meta__label" data-i18n="detail.status">STATUS</span>
            <span class="detail-meta__value" data-i18n={`svc.status.${svc.status.toLowerCase()}`}>{svc.status}</span>
          </div>
          <div class="detail-meta__item">
            <span class="detail-meta__label" data-i18n="detail.port">DEFAULT PORT</span>
            <span class="detail-meta__value">{svc.port}</span>
          </div>
          <div class="detail-meta__item">
            <span class="detail-meta__label" data-i18n="detail.license">LICENSE</span>
            <span class="detail-meta__value" data-i18n="detail.licenseValue">MIT · always free</span>
          </div>
          <div class="detail-meta__item detail-meta__item--source">
            <span class="detail-meta__label" data-i18n="detail.repository">REPOSITORY</span>
            <a class="detail-meta__source" href={svc.source} target="_blank" rel="noopener" data-i18n="detail.viewSource">VIEW SOURCE ↗</a>
          </div>
        </div>

        <h2 class="detail-body__sub" data-i18n="detail.responsibilities">Responsibilities</h2>
        <ul class="detail-features">
          {svc.responsibilities.map((r, i) => (
            <li class="detail-features__item" data-i18n={`svc.${svc.slug}.resp.${i}`}>{r}</li>
          ))}
        </ul>

        <!-- The endpoint list is code, not prose: it stays identical in every
             language, so it carries no translation key. -->
        <h2 class="detail-body__sub" data-i18n="detail.api">API surface</h2>
        <ul class="detail-api">
          {svc.api.map((endpoint) => (
            <li class="detail-api__item">{endpoint}</li>
          ))}
        </ul>

        <p class="detail-consumers">
          <span class="detail-consumers__label" data-i18n="detail.consumedBy">CONSUMED BY</span>
          <span data-i18n={`svc.${svc.slug}.consumers`}>{svc.consumers}</span>
          <span data-i18n="detail.neverDepends">A Platform Service never depends on a Business Module.</span>
        </p>

        <div class="detail-actions">
          <a href="/modules" class="btn btn--primary" data-i18n="detail.browseModules">Browse modules →</a>
          <a href="/platform" class="btn btn--ghost" data-i18n="detail.allServices">All services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Prev / Next -->
  <nav class="detail-nav" aria-label="Service navigation">
    <a href={`/platform/${prev.slug}`} class="detail-nav__link detail-nav__link--prev">
      <span class="detail-nav__dir" data-i18n="detail.prev">← PREVIOUS</span>
      <span class="detail-nav__title">{prev.n} · <span data-i18n={`svc.${prev.slug}.title`}>{prev.title}</span></span>
    </a>
    <a href={`/platform/${next.slug}`} class="detail-nav__link detail-nav__link--next">
      <span class="detail-nav__dir" data-i18n="detail.next">NEXT →</span>
      <span class="detail-nav__title">{next.n} · <span data-i18n={`svc.${next.slug}.title`}>{next.title}</span></span>
    </a>
  </nav>

</SubPage>

<style>
.detail-body-section {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}
.detail-body__inner {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
}
/* min-width:0 lets this grid track shrink below its content's intrinsic
   width, so the nowrap API list scrolls internally instead of stretching
   the whole page wider than the viewport. */
.detail-body__content { max-width: 720px; min-width: 0; }

.detail-body__overview {
  font-size: 19px;
  line-height: 1.6;
  color: var(--fg-dim);
  margin-bottom: 40px;
  overflow-wrap: anywhere;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 40px;
  padding: 24px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  margin-bottom: 48px;
}
.detail-meta__item { display: flex; flex-direction: column; gap: 8px; }
.detail-meta__label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.8px;
  color: var(--fg-mute);
}
.detail-meta__value {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  color: var(--fg);
}
.detail-meta__item--source { margin-left: auto; }
.detail-meta__source {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  color: var(--accent);
  transition: opacity 100ms ease-out;
}
.detail-meta__source:hover { opacity: 0.8; }

.detail-body__sub {
  font-family: 'Inter Tight', sans-serif;
  font-size: 24px;
  font-weight: 500;
  letter-spacing: -0.4px;
  margin-bottom: 24px;
}

.detail-features { margin-bottom: 48px; }
.detail-features__item {
  position: relative;
  padding: 16px 0 16px 28px;
  font-size: 15px;
  line-height: 1.6;
  color: var(--fg-dim);
  border-top: 1px solid var(--line);
}
.detail-features__item:last-child { border-bottom: 1px solid var(--line); }
.detail-features__item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 24px;
  width: 10px;
  height: 1px;
  background: var(--accent);
}

.detail-api {
  margin-bottom: 40px;
  border: 1px solid var(--line);
  background: var(--bg-3);
  overflow-x: auto; /* the box scrolls; the page never widens */
}
.detail-api__item {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  line-height: 1.5;
  color: var(--fg-dim);
  padding: 12px 18px;
  border-bottom: 1px solid var(--line);
  white-space: nowrap;
}
.detail-api__item:last-child { border-bottom: none; }

.detail-consumers {
  font-size: 14px;
  line-height: 1.65;
  color: var(--fg-dim);
  margin-bottom: 40px;
  overflow-wrap: anywhere;
}
.detail-consumers__label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.8px;
  color: var(--fg-mute);
  margin-right: 8px;
}

.detail-actions { display: flex; gap: 14px; flex-wrap: wrap; }

/* ─── Prev / next ─────────────────────────────────────────────────── */
.detail-nav {
  display: grid;
  grid-template-columns: 1fr 1fr;
  border-bottom: 1px solid var(--line);
}
.detail-nav__link {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 40px var(--pad-x);
  transition: background 120ms ease-out;
}
.detail-nav__link:hover { background: var(--bg-2); }
.detail-nav__link--next {
  align-items: flex-end;
  text-align: right;
  border-left: 1px solid var(--line);
}
.detail-nav__dir {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.8px;
  color: var(--fg-mute);
}
.detail-nav__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 18px;
  font-weight: 500;
  letter-spacing: -0.3px;
  color: var(--fg);
}

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 999px) {
  .detail-body__inner { grid-template-columns: 1fr; }
}
@media (max-width: 767px) {
  .detail-meta { gap: 24px; }
  /* Once the meta row wraps, don't push REPOSITORY to the far right — let
     it align left with the other items instead of orphaning it. */
  .detail-meta__item--source { margin-left: 0; }
  .detail-nav { grid-template-columns: 1fr; }
  .detail-nav__link--next {
    align-items: flex-start;
    text-align: left;
    border-left: none;
    border-top: 1px solid var(--line);
  }
}
</style>
