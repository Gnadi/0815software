---
import SubPage from '../layouts/SubPage.astro';
import { modules } from '../data/modules';

export const prerender = true;
---

<SubPage
  title="Modules — 0815software"
  description="Fourteen standard software modules for standard business problems. Scoped, MIT-licensed, and yours to keep."
  section="§ P1"
  sectionName="Modules"
  eyebrow="DIN 0815/M · MODULE CATALOGUE"
  heading="What we build."
  lead="Fourteen standard modules, each one a solved problem. Fixed scope, fixed price, handed off in weeks."
>

  <!-- Module grid -->
  <section class="modules-grid-section">
    <div class="modules-grid__head">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">§ P1.01</div>
        <div class="section-rail__name">Catalogue</div>
      </div>
      <p class="modules-grid__intro">
        Every module ships MIT-licensed with full source code. Pick one, combine several, or commission a custom scope built on top of an existing module.
      </p>
    </div>

    <div class="modules-grid">
      <div class="modules-grid__spacer" aria-hidden="true"></div>
      {modules.map((mod) => (
        <article class="mod-card">
          <a class="mod-card__link" href={`/modules/${mod.slug}`} aria-label={`${mod.title} — details`}>
            <div class="mod-card__num">{mod.n}</div>
            <h2 class="mod-card__title">{mod.title}</h2>
            <p class="mod-card__body">{mod.body}</p>
          </a>
          <div class="mod-card__meta">
            <span>TYPICAL SCOPE · {mod.scope}</span>
            <a class="mod-card__source" href={`/modules/${mod.slug}`}>DETAILS →</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="modules-cta-section">
    <div class="modules-cta__inner">
      <div class="section-rail" aria-hidden="true">
        <div class="section-rail__num">§ P1.02</div>
        <div class="section-rail__name">Commission</div>
      </div>
      <div class="modules-cta__content">
        <h2 class="modules-cta__h2">Need something not on this list?</h2>
        <p class="modules-cta__body">
          If it's a standard business problem, we've likely seen it. Describe what you need in a paragraph — we'll tell you if it maps to an existing module, a combination, or a new scope. New modules get published to this catalogue once built.
        </p>
        <a href="/#contact" class="btn btn--primary">Start a project →</a>
      </div>
    </div>
  </section>

</SubPage>

<style>
/* ─── Module grid section ─────────────────────────────────────────── */
.modules-grid-section {
  padding: var(--sec-y-sm) var(--pad-x);
  border-bottom: 1px solid var(--line);
}

.modules-grid__head {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  margin-bottom: 64px;
  align-items: start;
}

.modules-grid__intro {
  font-size: 15px;
  line-height: 1.65;
  color: var(--fg-dim);
  max-width: 640px;
}

.modules-grid {
  display: grid;
  grid-template-columns: 120px repeat(3, 1fr);
  gap: 0;
}

.modules-grid__spacer { /* empty rail spacer */ }

/* Module card */
.mod-card {
  padding: 28px 28px 28px 0;
  border-top: 1px solid var(--line);
  border-right: 1px solid var(--line);
}
.mod-card:nth-child(4n) { border-right: none; }

.mod-card__link {
  display: block;
}
.mod-card__link:hover .mod-card__title { opacity: 0.7; }
.mod-card__title { transition: opacity 100ms ease-out; }

.mod-card__num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--accent);
  letter-spacing: 0.8px;
  margin-bottom: 16px;
}

.mod-card__title {
  font-family: 'Inter Tight', sans-serif;
  font-size: 22px;
  font-weight: 500;
  letter-spacing: -0.4px;
  margin-bottom: 12px;
}

.mod-card__body {
  font-size: 14px;
  line-height: 1.6;
  color: var(--fg-dim);
  margin-bottom: 24px;
}

.mod-card__meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--fg-mute);
  letter-spacing: 0.8px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}

.mod-card__source {
  color: var(--accent);
  transition: opacity 100ms ease-out;
}

.mod-card__source:hover {
  opacity: 0.8;
}

/* ─── CTA section ─────────────────────────────────────────────────── */
.modules-cta-section {
  padding: var(--sec-y-sm) var(--pad-x);
}

.modules-cta__inner {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 48px;
  align-items: start;
}

.modules-cta__h2 {
  font-family: 'Inter Tight', sans-serif;
  font-size: 36px;
  font-weight: 500;
  letter-spacing: -0.8px;
  margin-bottom: 20px;
}

.modules-cta__body {
  font-size: 15px;
  line-height: 1.65;
  color: var(--fg-dim);
  max-width: 560px;
  margin-bottom: 32px;
}

/* ─── Responsive ──────────────────────────────────────────────────── */
@media (max-width: 1199px) {
  .modules-grid { grid-template-columns: 120px repeat(3, 1fr); }
  .modules-grid__head { gap: 32px; }
}

@media (max-width: 999px) {
  .modules-grid__head { grid-template-columns: 1fr; }
  .modules-grid { grid-template-columns: repeat(2, 1fr); }
  .modules-grid__spacer { display: none; }
  .mod-card { padding: 24px; }
  .mod-card:nth-child(4n) { border-right: 1px solid var(--line); }
  .mod-card:nth-child(2n) { border-right: none; }
  .modules-cta__inner { grid-template-columns: 1fr; }
}

@media (max-width: 767px) {
  .modules-grid { grid-template-columns: 1fr; }
  .mod-card { border-right: none !important; padding: 24px 0; }
  .modules-cta__h2 { font-size: 28px; }
}
</style>
