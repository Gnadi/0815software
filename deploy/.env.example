# Reference deployment secrets — ONE customer's stack.
# Copy to .env and replace every CHANGE-ME. Generate real values with:
#   openssl rand -hex 32
# The services boot with NODE_ENV=production, so the boot guard REFUSES to
# start while any of these still carries a known dev default.

# Public domain of this customer's platform (Caddy provisions TLS for it).
PLATFORM_DOMAIN=platform.customer.example

# ── Shared machine secret (module → service, ticker → service) ─────────
# Alternatively mint a scoped PS-01 API key (scopes: ["platform:admin"]) and
# use it instead — it is verified through the identity seam and revocable.
SERVICE_TOKEN=CHANGE-ME

# ── Per-stack session/signing secrets (one value is fine per stack) ────
SESSION_SECRET=CHANGE-ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME

# ── Service-specific secrets ───────────────────────────────────────────
WEBHOOK_SECRET=CHANGE-ME
# 64 hex chars — PS-05 credential encryption (openssl rand -hex 32):
INTEGRATION_ENCRYPTION_KEY=CHANGE-ME
# PS-06 signed download URLs (defaults to SESSION_SECRET when unset):
# SIGNING_SECRET=

# ── Optional real vendor adapters (mock/console fallback when unset) ───
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# STRIPE_SECRET_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Hardening (defaults shown; 0 disables) ─────────────────────────────
# RATE_LIMIT_RPM=600
# LOGIN_RATE_LIMIT_RPM=20
# CORS_ORIGINS=
# REQUEST_TIMEOUT_MS=30000

# Reverse proxies in front of the services. In THIS stack that is Caddy, and
# exactly one hop — without it every request looks like it came from Caddy, so
# the per-IP rate limits collapse into one shared bucket and PS-01's auth trail
# records the proxy instead of the client. Leave it at 0 only if a service is
# exposed directly, where a client could forge X-Forwarded-For.
TRUST_PROXY=1

# Outbound targets. PS-02, PS-03 and PS-05 call URLs an operator configures
# (webhooks, chat channels, connection base URLs) from inside this private
# network, so a target that resolves into private address space is refused —
# that is what stops a webhook aimed at another service in the stack. The
# stack's own hostnames are the exception; a generated stack fills this in
# automatically. EGRESS_MODE=observe logs instead of refusing, off disables it.
EGRESS_ALLOW_HOSTS=ps01,ps02,ps03,ps04,ps05,ps06,ps07,ps08,ps09,ps10,ps11
# EGRESS_MODE=block
