# Reference deployment secrets — ONE customer's stack.
# Copy to .env and replace every CHANGE-ME. Generate real values with:
#   openssl rand -hex 32
# The services boot with NODE_ENV=production, so the boot guard REFUSES to
# start while any of these still carries a known dev default.

# Public domain of this customer's platform (Caddy provisions TLS for it).
PLATFORM_DOMAIN=platform.customer.example

# ── Shared machine secret (module → service, ticker → service) ─────────
# Alternatively mint a scoped PS-01 API key (scopes: ["platform:admin"]) and
# use it instead — it is verified through the identity seam and revocable.
SERVICE_TOKEN=CHANGE-ME

# ── Per-stack session/signing secrets (one value is fine per stack) ────
SESSION_SECRET=CHANGE-ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME

# ── Service-specific secrets ───────────────────────────────────────────
WEBHOOK_SECRET=CHANGE-ME
# 64 hex chars — PS-05 credential encryption (openssl rand -hex 32):
INTEGRATION_ENCRYPTION_KEY=CHANGE-ME
# PS-06 signed download URLs (defaults to SESSION_SECRET when unset):
# SIGNING_SECRET=

# ── Optional real vendor adapters (mock/console fallback when unset) ───
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# STRIPE_SECRET_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Hardening (defaults shown; 0 disables) ─────────────────────────────
# RATE_LIMIT_RPM=600
# LOGIN_RATE_LIMIT_RPM=20
# CORS_ORIGINS=
# REQUEST_TIMEOUT_MS=30000
