# ── Demo domain ──────────────────────────────────────────────────────────────
# The demo is served on DEMO_DOMAIN (the hub) plus four subdomains (the apps).
# Point DNS at this host — a wildcard is easiest:
#
#   demo.example.com            A   <this host's public IP>
#   *.demo.example.com          A   <this host's public IP>
#
# (or four explicit A records: offers. invoicing. support. documents.)
DEMO_DOMAIN=demo.example.com

# Email used for the Let's Encrypt certificates Caddy provisions automatically.
ACME_EMAIL=ops@example.com

# ── Secrets — generate each with: openssl rand -hex 32 ───────────────────────
# Shared machine token between the apps and the platform services.
SERVICE_TOKEN=CHANGE-ME
# HMAC key for the apps' and services' sessions.
SESSION_SECRET=CHANGE-ME
# Local admin password (SSO uses the seeded demo users; this satisfies the
# production boot guard).
ADMIN_PASSWORD=CHANGE-ME
# Payments (PS-08) webhook signing secret.
WEBHOOK_SECRET=CHANGE-ME
# Support (mod-12) email-intake secret.
INTAKE_SECRET=CHANGE-ME
