# MOD-16 Whistleblowing — runtime configuration.
# Every value has a local-dev default; copy to .env and change the secrets
# before deploying anywhere. The report categories, the case lifecycle and
# the three statutory periods are NOT env vars — they are declarative code
# config (server/case-config.ts), and most of them are law rather than
# preference.

# API / production server port
PORT=3016

# SQLite database file (created automatically on first run)
DATABASE_PATH=./data.db

# Who is named as the recipient on the public intake page. § 17 Abs. 1
# HinSchG: a reporter is entitled to know who is receiving their report.
ORGANISATION_NAME=Example GmbH

# Per-IP access-code lookups per minute, on top of the general limiter.
# This is the module's other credential endpoint, so it gets the login's
# treatment. 0 disables it (the tests do that deliberately).
LOOKUP_RATE_LIMIT_RPM=20

# The case handler's login (MOD-03/04 pattern — one shared account).
# For a real deployment prefer IDENTITY_URL below: § 17 Abs. 1 HinSchG wants
# reports reaching DESIGNATED people, and a shared account cannot show which
# of them opened a case.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Signs the stateless HMAC session cookie. CHANGE THIS.
# Note: it does NOT sign reporter access codes — those are random and only
# their hash is stored, so a leaked secret cannot open anyone's case.
SESSION_SECRET=dev-secret-change-me

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Set true behind HTTPS so the session cookie carries the Secure attribute
COOKIE_SECURE=false

# ── Platform Services (optional) ───────────────────────────────────────
# When set, this module records the FACT of each case action on PS-07 Audit
# Log — the ref and the verb, never the report text. Unset means standalone.
# AUDIT_URL=http://localhost:4007
# NOTIFICATION_URL=http://localhost:4003
# PLATFORM_SERVICE_TOKEN=dev-service-token

# ── Single sign-on via PS-01 Identity (optional) ───────────────────────
# When IDENTITY_URL is set, handler logins are verified against PS-01 instead
# of the local ADMIN_* pair, and each handler acts under their own name in
# the case trail. Scope the permission tightly — everyone who holds it can
# read every report.
# IDENTITY_URL=http://localhost:4001
# IDENTITY_ORG=acme
# IDENTITY_PERMISSION=whistleblowing.handle

# ── Hardening (defaults shown; 0 disables a limiter) ───────────────────
# Security headers are always sent. These knobs tune the rest of
# server/hardening.ts: per-IP rate limits, the CORS allowlist and the
# socket timeout. HSTS is on automatically when NODE_ENV=production.
# A value that is not a non-negative number (a typo, or an empty string
# from an unset variable interpolated into a compose file) falls back to
# the default rather than silently switching the limiter off.
# RATE_LIMIT_RPM=600
# LOGIN_RATE_LIMIT_RPM=20
# CORS_ORIGINS=
# REQUEST_TIMEOUT_MS=30000

# Reverse proxies in front of this service. Behind the deploy stack's Caddy
# that is 1 — without it every request carries the proxy's address, so the
# per-IP limits above throttle all clients as one. Leave it at 0 when the
# service is reachable directly: a client could otherwise forge the header.
# TRUST_PROXY=0
