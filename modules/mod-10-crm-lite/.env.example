# MOD-10 CRM Lite — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.
#
# The pipeline stages (keys, labels and default win-probabilities) are
# NOT environment variables — they are declarative config in exactly one
# file, server/pipeline-config.ts (see README).

# HTTP port of the API / production server
PORT=3010

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Admin credentials — the single staff login for the app.
# Local-dev defaults are admin / admin. CHANGE THESE IN PRODUCTION.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Secret used to sign the session cookie. Any long random string.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Set to "true" behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# ── Platform Services (optional) ───────────────────────────────────────
# When AUDIT_URL is set, key changes are recorded on PS-07 Audit Log. Unset
# means standalone (no outbound calls).
# AUDIT_URL=http://localhost:4007
# PS-11 Customers: when set, a company created here is registered with the
# stack's party master data, so a module that later quotes or invoices it
# resolves the SAME party. Unset means the local companies table is all.
# CUSTOMERS_URL=http://localhost:4011
# PLATFORM_SERVICE_TOKEN=dev-service-token

# ── Hardening (defaults shown; 0 disables a limiter) ───────────────────
# Security headers are always sent. These knobs tune the rest of
# server/hardening.ts: per-IP rate limits, the CORS allowlist and the
# socket timeout. HSTS is on automatically when NODE_ENV=production.
# RATE_LIMIT_RPM=600
# LOGIN_RATE_LIMIT_RPM=20
# CORS_ORIGINS=
# REQUEST_TIMEOUT_MS=30000

# Reverse proxies in front of this service. Behind the deploy stack's Caddy
# that is 1 — without it every request carries the proxy's address, so the
# per-IP limits above throttle all clients as one. Leave it at 0 when the
# service is reachable directly: a client could otherwise forge the header.
# TRUST_PROXY=0
