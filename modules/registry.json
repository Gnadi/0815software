    {
      "id": "ps-01-identity",
      "n": "PS-01",
      "label": "Identity",
      "defaultPort": 4001,
      "routePrefix": "/identity",
      "urlEnv": "IDENTITY_URL",
      "tickDriven": false,
      "secrets": ["SESSION_SECRET"]
    },
    {
      "id": "ps-02-workflow-engine",
      "n": "PS-02",
      "label": "Workflow",
      "defaultPort": 4002,
      "routePrefix": "/workflow",
      "urlEnv": "WORKFLOW_URL",
      "tickDriven": true,
      "secrets": ["SESSION_SECRET", "ADMIN_PASSWORD", "SERVICE_TOKEN"]
    },
    {
      "id": "ps-03-notification-hub",
      "n": "PS-03",
      "label": "Notifications",
      "defaultPort": 4003,
      "routePrefix": "/notify",
      "urlEnv": "NOTIFICATION_URL",
      "tickDriven": true,
      "secrets": ["SESSION_SECRET", "ADMIN_PASSWORD", "SERVICE_TOKEN"]
    },
    {
      "id": "ps-04-ai-platform",
      "n": "PS-04",
      "label": "AI",
      "defaultPort": 4004,
      "routePrefix": "/ai",
      "urlEnv": "AI_URL",
      "tickDriven": false,
      "secrets": ["SESSION_SECRET", "ADMIN_PASSWORD", "SERVICE_TOKEN"]
    },
