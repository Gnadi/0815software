{
  "name": "@0815software/mod-07-storefront",
  "version": "0.1.0",
  "description": "MOD-07 Storefront \u2014 product catalogue, cart, checkout, and order management. No SaaS fees, no revenue cut.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "seed": "tsx server/seed.ts",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/index.js",
    "backup": "node scripts/backup.mjs",
    "test": "vitest run",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@0815software/platform-clients": "file:../../platform/clients",
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.4",
    "vitest": "^3.2.4"
  }
}
