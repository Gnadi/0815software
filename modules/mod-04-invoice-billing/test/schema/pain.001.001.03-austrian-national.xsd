							<xd:documentation xml:lang="de">Zusätzlicher Verwendungszweck</xd:documentation>
							<xd:documentation xml:lang="en">Additional remittance information</xd:documentation>
						</xd:annotation>
					</xd:element>
				</xd:sequence>
			</xd:restriction>
		</xd:complexContent>
	</xd:complexType>
