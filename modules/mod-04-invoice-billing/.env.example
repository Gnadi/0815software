# MOD-04 Invoice & Billing — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API / production server
PORT=3004

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Admin credentials — the single staff login for the app.
# Local-dev defaults are admin / admin. CHANGE THESE IN PRODUCTION.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Secret used to sign the session cookie. Any long random string.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Set to "true" behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# Seller identity printed on invoice PDFs (the letterhead block).
# SELLER_ADDRESS uses "|" as the line separator.
SELLER_NAME=0815software GmbH
SELLER_ADDRESS=Beispielgasse 8/15|1010 Wien|Austria
SELLER_VAT_ID=ATU00000000
SELLER_IBAN=AT00 0000 0000 0000 0000
SELLER_BIC=EXAMPLEX

# ── Platform Services (optional) ───────────────────────────────────────
# When set, issuing an invoice also emails the customer (PS-03), archives the
# PDF (PS-06), and records an audit event (PS-07). All optional — unset means
# mod-04 runs fully standalone with no outbound calls.
# NOTIFICATION_URL=http://localhost:4003
# FILES_URL=http://localhost:4006
# AUDIT_URL=http://localhost:4007
# PLATFORM_SERVICE_TOKEN=dev-service-token
# NOTIFICATION_INVOICE_CHANNEL=transactional-email
