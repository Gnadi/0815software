# MOD-04 Invoice & Billing — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API / production server
PORT=3004

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Admin credentials — the single staff login for the app.
# Local-dev defaults are admin / admin. CHANGE THESE IN PRODUCTION.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Secret used to sign the session cookie. Any long random string.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Set to "true" behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# Seller identity printed on invoice PDFs (the letterhead block).
# SELLER_ADDRESS uses "|" as the line separator.
SELLER_NAME=0815software GmbH
SELLER_ADDRESS=Beispielgasse 8/15|1010 Wien|Austria
SELLER_VAT_ID=ATU00000000
SELLER_IBAN=AT00 0000 0000 0000 0000
SELLER_BIC=EXAMPLEX

# ── Platform Services (optional) ───────────────────────────────────────
# When set, issuing an invoice also emails the customer (PS-03), archives the
# PDF (PS-06), and records an audit event (PS-07). All optional — unset means
# mod-04 runs fully standalone with no outbound calls.
# NOTIFICATION_URL=http://localhost:4003
# FILES_URL=http://localhost:4006
# AUDIT_URL=http://localhost:4007
# PAYMENTS_URL=http://localhost:4008        # enables POST /api/invoices/:id/pay
# NUMBER_URL=http://localhost:4010          # source invoice numbers from PS-10
# PS-11 Customers: when set, an imported customer is resolved against the
# stack's party master data instead of being copied blind, so this module and
# MOD-13 Offers mean the same customer. Unset means local matching only.
# CUSTOMERS_URL=http://localhost:4011
# PLATFORM_SERVICE_TOKEN=dev-service-token
# NOTIFICATION_INVOICE_CHANNEL=transactional-email

# ── Billing an accepted offer (optional) ───────────────────────────────
# When set, POST /api/invoices/import-offer fetches an accepted offer from
# MOD-13 Offers as a neutral document transfer (shared/transfer.ts) and turns
# it into a draft invoice — the "bill this quote" action, idempotent on the
# offer number. Unset means the endpoint answers 501 and this module has no
# notion of offers at all, exactly as before.
# The same PLATFORM_SERVICE_TOKEN above authenticates the call.
# OFFERS_URL=http://localhost:3013

# ── Hardening (defaults shown; 0 disables a limiter) ───────────────────
# Security headers are always sent. These knobs tune the rest of
# server/hardening.ts: per-IP rate limits, the CORS allowlist and the
# socket timeout. HSTS is on automatically when NODE_ENV=production.
# RATE_LIMIT_RPM=600
# LOGIN_RATE_LIMIT_RPM=20
# CORS_ORIGINS=
# REQUEST_TIMEOUT_MS=30000
