# MOD-09 Document Management — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API / production server
PORT=3009

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Directory where uploaded document bytes are stored, addressed by their
# SHA-256 hash (created automatically; the seed script writes example
# files here). Never committed.
STORAGE_DIR=./storage

# Maximum upload size in bytes (default 25 MiB). Larger uploads are
# rejected with 413.
MAX_UPLOAD_BYTES=26214400

# Secret used to sign the session cookie. Any long random string.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Set to "true" behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# ── Platform Services (optional) ───────────────────────────────────────
# When set, each uploaded document version is mirrored to PS-06 File Storage
# and recorded on PS-07 Audit Log. Unset means standalone (local storage only).
# FILES_URL=http://localhost:4006
# AUDIT_URL=http://localhost:4007
# SEARCH_URL=http://localhost:4009          # index docs + back GET /api/search
# PLATFORM_SERVICE_TOKEN=dev-service-token

# ── Hardening (defaults shown; 0 disables a limiter) ───────────────────
# Security headers are always sent. These knobs tune the rest of
# server/hardening.ts: per-IP rate limits, the CORS allowlist and the
# socket timeout. HSTS is on automatically when NODE_ENV=production.
# A value that is not a non-negative number (a typo, or an empty string
# from an unset variable interpolated into a compose file) falls back to
# the default rather than silently switching the limiter off.
# RATE_LIMIT_RPM=600
# LOGIN_RATE_LIMIT_RPM=20
# CORS_ORIGINS=
# REQUEST_TIMEOUT_MS=30000

# Reverse proxies in front of this service. Behind the deploy stack's Caddy
# that is 1 — without it every request carries the proxy's address, so the
# per-IP limits above throttle all clients as one. Leave it at 0 when the
# service is reachable directly: a client could otherwise forge the header.
# TRUST_PROXY=0

# ── The MOD-15 Workspace shell ─────────────────────────────────────────
# PLATFORM_SERVICE_TOKEN guards GET /api/summary — the figures this module
# contributes to a Workspace board. With no token set the endpoint is closed.
#
# This module reads NO SHELL_ORIGIN and cannot be embedded: its end users are
# not staff, so a shell has no principal to sign in as. A board shows its
# figures and opens it in a new tab.
