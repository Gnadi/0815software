# MOD-14 Subsidies & Funds — runtime configuration.
# Every value has a local-dev default; copy to .env and change the secrets
# before deploying anywhere. The application status workflow and the
# reporting at-risk window are NOT env vars — they are declarative code
# config (server/status-config.ts, server/reporting-config.ts).

# API / production server port
PORT=3014

# SQLite database file (created automatically on first run)
DATABASE_PATH=./data.db

# The single admin login (MOD-03/04 pattern — one shared account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Signs the stateless HMAC session cookie. CHANGE THIS.
SESSION_SECRET=dev-secret-change-me

# Session lifetime in hours
SESSION_TTL_HOURS=12

# Set true behind HTTPS so the session cookie carries the Secure attribute
COOKIE_SECURE=false

# ── Platform Services (optional) ───────────────────────────────────────
# When set, this module records changes on PS-07 Audit Log and sends
# notifications via PS-03 Notification Hub. Unset means standalone.
# AUDIT_URL=http://localhost:4007
# NOTIFICATION_URL=http://localhost:4003
# PLATFORM_SERVICE_TOKEN=dev-service-token

# ── Hardening (defaults shown; 0 disables a limiter) ───────────────────
# Security headers are always sent. These knobs tune the rest of
# server/hardening.ts: per-IP rate limits, the CORS allowlist and the
# socket timeout. HSTS is on automatically when NODE_ENV=production.
# A value that is not a non-negative number (a typo, or an empty string
# from an unset variable interpolated into a compose file) falls back to
# the default rather than silently switching the limiter off.
# RATE_LIMIT_RPM=600
# LOGIN_RATE_LIMIT_RPM=20
# CORS_ORIGINS=
# REQUEST_TIMEOUT_MS=30000

# Reverse proxies in front of this service. Behind the deploy stack's Caddy
# that is 1 — without it every request carries the proxy's address, so the
# per-IP limits above throttle all clients as one. Leave it at 0 when the
# service is reachable directly: a client could otherwise forge the header.
# TRUST_PROXY=0

# ── The MOD-15 Workspace shell (optional) ──────────────────────────────
# Set to the Workspace's origin to let it embed this module and sign its
# users in. It does two things and nothing else:
#   * swaps this module's blanket `X-Frame-Options: DENY` for a
#     `Content-Security-Policy: frame-ancestors <SHELL_ORIGIN>` naming ONLY
#     that origin, and
#   * opens POST /api/session/handoff and POST /api/session/issue, both
#     guarded by PLATFORM_SERVICE_TOKEN, through which the Workspace obtains
#     a session for whoever is using it.
# This module still mints its own sessions — the shell only asserts WHO.
# Unset (the default) none of it exists: framing is denied outright and the
# routes are not mounted. A malformed value stops the boot rather than being
# dropped, because a dropped one produces an empty frame and a silent log.
# deploy/provision.mjs sets this automatically when a Workspace is in the stack.
# SHELL_ORIGIN=https://workspace.example
#
# NOTE: PLATFORM_SERVICE_TOKEN also guards GET /api/summary — the figures and
# short lists this module contributes to a Workspace board. With no token set
# that endpoint is closed too.
