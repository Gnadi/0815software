# MOD-12 Support Ticket System — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.
#
# The status workflow (allowed transitions) and the SLA policy are NOT
# environment variables — they are declarative config in
# server/status-config.ts and server/sla-config.ts (see README).

# HTTP port of the API / production server
PORT=3012

# Path to the SQLite database file (created automatically)
DATABASE_PATH=./data.db

# Agent credentials — the single staff login for the queue side.
# Local-dev defaults are agent / agent. CHANGE THESE IN PRODUCTION.
ADMIN_USERNAME=agent
ADMIN_PASSWORD=agent

# Secret used to sign the agent session cookie AND the public ticket
# lookup tokens. Any long random string. openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Set to "true" behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# Shared secret required in the X-Intake-Secret header on the email
# ingestion endpoint (POST /api/intake/email). The mailbox bridge that
# posts parsed emails here must send this header. CHANGE IN PRODUCTION.
INTAKE_SECRET=dev-intake-secret

# ── Platform Services (optional) ───────────────────────────────────────
# When set, a new ticket is acknowledged to the requester (PS-03) and recorded
# on the audit trail (PS-07), and POST /api/tickets/:ref/suggest-reply drafts
# an agent reply via the AI platform (PS-04). All optional — unset means
# mod-12 runs fully standalone with no outbound calls.
# NOTIFICATION_URL=http://localhost:4003
# AUDIT_URL=http://localhost:4007
# AI_URL=http://localhost:4004
# PLATFORM_SERVICE_TOKEN=dev-service-token
# NOTIFICATION_ACK_CHANNEL=transactional-email
