# MOD-16 Mosaic — configuration
# Copy to .env (or export in your shell) and adjust. Every value has a
# local-dev default; set real values before deploying anywhere.

# HTTP port of the API / production server
PORT=3016

# Path to the SQLite database file (created automatically). It holds board
# layouts and nothing else — every figure on a board is fetched live from the
# module that owns it, so there is no cached data here to go stale.
DATABASE_PATH=./data.db

# Admin credentials — the single staff login for the app.
# Local-dev defaults are admin / admin. CHANGE THESE IN PRODUCTION.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Secret used to sign the session cookie. Any long random string.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=dev-secret-change-me

# Session lifetime in hours (default 12)
SESSION_TTL_HOURS=12

# Set to "true" behind HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false

# This Mosaic's own public origin. Set it to the SAME value you set as
# SHELL_ORIGIN on every module below — that is the pairing that lets those
# modules be framed here and sign this Mosaic's users in.
PUBLIC_BASE_URL=http://localhost:3016

# ── The modules on the board ───────────────────────────────────────────
# Each module needs TWO addresses, and they are not interchangeable:
#
#   <MODULE>_URL          the INTERNAL address this server calls for summaries
#                         and session handoffs (a container name in a stack)
#   <MODULE>_PUBLIC_URL   the CUSTOMER-FACING origin a BROWSER uses for frames
#                         and deep links
#
# Setting only the internal one is valid: that module's figures appear on the
# board, but it cannot be embedded or linked to. Setting only the public one
# does nothing — there would be no summary to show.
#
# A module with neither set is simply not in this stack, and the board says so.
# A malformed value is refused at boot rather than dropped, because a dropped
# one looks exactly like "not licensed" and nobody goes looking for a typo in
# a state that looks intentional.
#
# PORTAL_URL=http://localhost:3001
# PORTAL_PUBLIC_URL=https://portal.example
# ADMIN_URL=http://localhost:3002
# ADMIN_PUBLIC_URL=https://admin.example
# INVENTORY_URL=http://localhost:3003
# INVENTORY_PUBLIC_URL=https://inventory.example
# INVOICING_URL=http://localhost:3004
# INVOICING_PUBLIC_URL=https://invoicing.example
# DIRECTORY_URL=http://localhost:3005
# DIRECTORY_PUBLIC_URL=https://directory.example
# PROCUREMENT_URL=http://localhost:3006
# PROCUREMENT_PUBLIC_URL=https://procurement.example
# SHOP_URL=http://localhost:3007
# SHOP_PUBLIC_URL=https://shop.example
# REPORTING_URL=http://localhost:3008
# REPORTING_PUBLIC_URL=https://reporting.example
# DOCUMENTS_URL=http://localhost:3009
# DOCUMENTS_PUBLIC_URL=https://documents.example
# CRM_URL=http://localhost:3010
# CRM_PUBLIC_URL=https://crm.example
# TIME_URL=http://localhost:3011
# TIME_PUBLIC_URL=https://time.example
# SUPPORT_URL=http://localhost:3012
# SUPPORT_PUBLIC_URL=https://support.example
# OFFERS_URL=http://localhost:3013
# OFFERS_PUBLIC_URL=https://offers.example
# SUBSIDIES_URL=http://localhost:3014
# SUBSIDIES_PUBLIC_URL=https://subsidies.example

# How long a module has to answer before its widget gives up (ms, default
# 5000). Peers are called concurrently, so this is the board's worst case,
# not the sum of them.
# PEER_TIMEOUT_MS=5000

# ── Platform Services (optional) ───────────────────────────────────────
# PLATFORM_SERVICE_TOKEN is the one value the board cannot work without in a
# real stack: it is what every module requires before it will answer a summary
# or mint a session. Unset, the Mosaic still runs and every widget says why
# it is empty.
# PLATFORM_SERVICE_TOKEN=dev-service-token
#
# PS-07 Audit Log feeds the activity widget. Every module already records its
# state changes there, so the feed needs no module-side work at all.
# AUDIT_URL=http://localhost:4007
#
# PS-11 Customers feeds the context bar's customer picker. It is the only
# identity every module can be narrowed by — "the same customer" means one
# party id everywhere rather than a name that has to match in fourteen
# databases. Unset, the picker says so instead of looking empty.
# CUSTOMERS_URL=http://localhost:4011
#
# PS-03 Notification Hub is read for nothing today; the variable exists so the
# wiring matches every other module's.
# NOTIFICATION_URL=http://localhost:4003

# ── Single sign-on (optional) ──────────────────────────────────────────
# When set, PS-01 Identity validates the login and the Mosaic issues its
# own session carrying that identity — which is what makes boards per PERSON
# rather than per stack, and what puts a real name on every cross-module
# action this board performs. Unset, everyone shares the local admin account
# and therefore shares one set of boards.
# IDENTITY_URL=http://localhost:4001
# IDENTITY_ORG=acme
# IDENTITY_PERMISSION=platform:admin

# ── Embedding this Mosaic elsewhere (optional) ──────────────────────
# Present for symmetry with the rest of the catalogue: set it and this module
# can itself be framed by another shell. Unset — the default, and every
# deployment we ship — it keeps sending X-Frame-Options: DENY.
# SHELL_ORIGIN=

# ── Hardening (defaults shown; 0 disables a limiter) ───────────────────
# Security headers are always sent. These knobs tune the rest of
# server/hardening.ts: per-IP rate limits, the CORS allowlist and the
# socket timeout. HSTS is on automatically when NODE_ENV=production.
# RATE_LIMIT_RPM=600
# LOGIN_RATE_LIMIT_RPM=20
# CORS_ORIGINS=
# REQUEST_TIMEOUT_MS=30000

# Reverse proxies in front of this service. Behind the deploy stack's Caddy
# that is 1 — without it every request carries the proxy's address, so the
# per-IP limits above throttle all clients as one.
# TRUST_PROXY=0
